// Koru Standard Library: the `markers` part of proto — erased-marker
// scanning. Joined via `~part markers` in proto.kz; merged into the
// proto module.
//
// Proto decls self-erase to comment markers (`// proto Name: ...`,
// `// proto-terminal Name: scalar`) so post-transform passes and consumers
// can still resolve what a name declared. These predicates read those
// markers back.

fn markerDeclaresTerminalLine(line: []const u8, want: []const u8) bool {
    const marker = std.mem.trimLeft(u8, line, " \t");
    const prefix = "// proto-terminal ";
    if (!std.mem.startsWith(u8, marker, prefix)) return false;
    const colon = std.mem.indexOfScalar(u8, marker[prefix.len..], ':') orelse return false;
    const declared = std.mem.trim(u8, marker[prefix.len .. prefix.len + colon], " \t");
    return std.mem.eql(u8, declared, want);
}

fn markerDeclaresTerminal(code: []const u8, want: []const u8) bool {
    var lines = std.mem.splitScalar(u8, code, '\n');
    while (lines.next()) |line| {
        if (markerDeclaresTerminalLine(line, want)) return true;
    }
    return false;
}

fn markerDeclaresCompoundLine(line: []const u8, want: []const u8) bool {
    const marker = std.mem.trimLeft(u8, line, " \t");
    const prefix = "// proto ";
    if (!std.mem.startsWith(u8, marker, prefix)) return false;
    const colon = std.mem.indexOfScalar(u8, marker[prefix.len..], ':') orelse return false;
    const declared = std.mem.trim(u8, marker[prefix.len .. prefix.len + colon], " \t");
    return std.mem.eql(u8, declared, want);
}

fn markerDeclaresCompound(code: []const u8, want: []const u8) bool {
    var lines = std.mem.splitScalar(u8, code, '\n');
    while (lines.next()) |line| {
        if (markerDeclaresCompoundLine(line, want)) return true;
    }
    return false;
}
