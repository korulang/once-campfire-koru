// Koru Standard Library: the `fpgatb` part of kernel.kz — the `self|fpga`
// testbench emission (`~part fpgatb`, merged into the kernel module):
// drive the init dataset, check ports one beat later, `$fatal` on a miss.
//
// Port semantics mirror the module's: `expw_*` computes the map
// signed-wide (sign- or zero-extending `in_*` to match), bare bounds
// slice to the port — "truncated"; a clamp claim saturates `exp_*` into
// the effective range — "saturated". Divergence prints, never silently.

fn emitFpgaTb(
    alloc: std.mem.Allocator,
    sym: []const u8,
    shape_fields: []const kast.Field,
    ports: []const FpgaPort,
    elems: []const []i64,
    mapped: usize,
    sv_op: u8,
    lit: i64,
    sat: ?[2]i64,
) void {
    var tb = std.ArrayList(u8).initCapacity(alloc, 2048) catch unreachable;
    const w = struct {
        fn p(buf: *std.ArrayList(u8), a: std.mem.Allocator, comptime fmt: []const u8, args: anytype) void {
            buf.appendSlice(a, std.fmt.allocPrint(a, fmt, args) catch unreachable) catch unreachable;
        }
    }.p;

    w(&tb, alloc, "// Generated testbench for {s} — drives the init dataset on\n", .{sym});
    w(&tb, alloc, "// consecutive beats, checks the stage's output one beat later.\n", .{});
    w(&tb, alloc, "// errors exit nonzero via $fatal so the BUILD fails on a wrong circuit.\n", .{});
    w(&tb, alloc, "module tb;\n    logic clk = 0;\n    logic rst_n = 0;\n    logic in_valid = 0;\n", .{});
    for (shape_fields, 0..) |sf, sfi| {
        w(&tb, alloc, "    logic {s}[{d}:0] in_{s} = 0;\n", .{ if (ports[sfi].sign) "signed " else "", ports[sfi].bits - 1, sf.name });
    }
    w(&tb, alloc, "    logic out_valid;\n", .{});
    for (shape_fields, 0..) |sf, sfi| {
        w(&tb, alloc, "    logic {s}[{d}:0] out_{s};\n", .{ if (ports[sfi].sign) "signed " else "", ports[sfi].bits - 1, sf.name });
        w(&tb, alloc, "    logic {s}[{d}:0] exp_{s};\n", .{ if (ports[sfi].sign) "signed " else "", ports[sfi].bits - 1, sf.name });
    }
    // The gate: out_* vs the port-width slice of expw_*; divergence = `note:`.
    w(&tb, alloc, "    logic signed [63:0] expw_{s};\n", .{shape_fields[mapped].name});
    w(&tb, alloc, "\n    {s} dut (.*);\n\n    always #5 clk = ~clk;\n\n    int errors = 0;\n\n", .{sym});
    // check(): mapped field vs the map of the last input, rest passthrough.
    w(&tb, alloc, "    task check;\n        if (!out_valid", .{});
    for (shape_fields) |sf| {
        w(&tb, alloc, " || out_{s} !== exp_{s}", .{ sf.name, sf.name });
    }
    w(&tb, alloc, ") begin\n            $display(\"FAIL: got valid=%b", .{});
    for (shape_fields) |sf| {
        w(&tb, alloc, " {s}=%0d", .{sf.name});
    }
    w(&tb, alloc, ", want", .{});
    for (shape_fields) |sf| {
        w(&tb, alloc, " {s}=%0d", .{sf.name});
    }
    w(&tb, alloc, "\"", .{});
    w(&tb, alloc, ", out_valid", .{});
    for (shape_fields) |sf| {
        w(&tb, alloc, ", out_{s}", .{sf.name});
    }
    for (shape_fields) |sf| {
        w(&tb, alloc, ", exp_{s}", .{sf.name});
    }
    w(&tb, alloc, ");\n            errors = errors + 1;\n        end else begin\n            $display(\"ok:", .{});
    for (shape_fields) |sf| {
        w(&tb, alloc, " {s}=%0d", .{sf.name});
    }
    w(&tb, alloc, "\"", .{});
    for (shape_fields) |sf| {
        w(&tb, alloc, ", out_{s}", .{sf.name});
    }
    w(&tb, alloc, ");\n            if (expw_{s} != out_{s}) $display(\"note: {s} {s} %0d -> %0d ({d}-bit port)\", expw_{s}, out_{s});\n", .{
        shape_fields[mapped].name, shape_fields[mapped].name, shape_fields[mapped].name,
        if (sat != null) "saturated" else "truncated", ports[mapped].bits,
        shape_fields[mapped].name, shape_fields[mapped].name,
    });
    w(&tb, alloc, "        end\n    endtask\n\n    initial begin\n        @(negedge clk); rst_n = 1;\n", .{});

    for (elems, 0..) |ev, ei| {
        w(&tb, alloc, "        // beat {d}: drive element {d}\n        @(negedge clk);", .{ ei + 1, ei });
        if (ei > 0) w(&tb, alloc, " check();", .{});
        w(&tb, alloc, " in_valid = 1;", .{});
        for (shape_fields, 0..) |sf, sfi| {
            const dlit = fpgaPortLit(ev[sfi], ports[sfi]);
            w(&tb, alloc, " in_{s} = {s}{d}'{s}d{d};", .{ sf.name, dlit.neg, dlit.bits, dlit.s, dlit.mag });
        }
        w(&tb, alloc, "\n        ", .{});
        for (shape_fields, 0..) |sf, sfi| {
            if (sfi == mapped) {
                if (ports[sfi].sign) {
                    w(&tb, alloc, "expw_{s} = $signed(in_{s}) {c} {s}64'sd{d}; ", .{ sf.name, sf.name, sv_op, if (lit < 0) "-" else "", @abs(lit) });
                } else {
                    w(&tb, alloc, "expw_{s} = $signed({{1'b0, in_{s}}}) {c} {s}64'sd{d}; ", .{ sf.name, sf.name, sv_op, if (lit < 0) "-" else "", @abs(lit) });
                }
                if (sat) |sc| {
                    const hi_lit = fpgaPortLit(sc[1], ports[sfi]);
                    const lo_lit = fpgaPortLit(sc[0], ports[sfi]);
                    w(&tb, alloc, "exp_{s} = (expw_{s} > {s}64'sd{d}) ? {s}{d}'{s}d{d} : (expw_{s} < {s}64'sd{d}) ? {s}{d}'{s}d{d} : expw_{s}[{d}:0];", .{
                        sf.name, sf.name, if (sc[1] < 0) "-" else "", @abs(sc[1]), hi_lit.neg, hi_lit.bits, hi_lit.s, hi_lit.mag,
                        sf.name, if (sc[0] < 0) "-" else "", @abs(sc[0]), lo_lit.neg, lo_lit.bits, lo_lit.s, lo_lit.mag, sf.name, ports[sfi].bits - 1,
                    });
                } else {
                    w(&tb, alloc, "exp_{s} = expw_{s}[{d}:0];", .{ sf.name, sf.name, ports[sfi].bits - 1 });
                }
            } else {
                w(&tb, alloc, "exp_{s} = in_{s};", .{ sf.name, sf.name });
            }
        }
        w(&tb, alloc, "\n", .{});
    }
    w(&tb, alloc, "        // drain: last check, then drop valid\n        @(negedge clk); check(); in_valid = 0;\n\n        if (errors == 0) $display(\"PASS: {s} pipeline\");\n        else             $fatal(1, \"FAIL: %0d errors\", errors);\n        $finish;\n    end\nendmodule\n", .{sym});

    const fname = std.fmt.allocPrint(alloc, "{s}.fpga_tb.sv", .{sym}) catch unreachable;
    const mf = std.fs.cwd().createFile(fname, .{}) catch |e| {
        std.debug.print("error: `self|fpga` cannot write {s}: {s}\n", .{ fname, @errorName(e) });
        std.process.exit(1);
    };
    defer mf.close();
    mf.writeAll(tb.items) catch unreachable;
}
