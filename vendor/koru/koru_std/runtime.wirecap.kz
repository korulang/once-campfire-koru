// Koru Standard Library: the `wirecap` part of runtime — captured-text
// scanning for `Expression`/`Source` wire fields: balanced-text extraction,
// canonical quoting, and the bare-reference judgment. Joined via
// `~part wirecap` in runtime.kz; merged into the runtime module at load.

// Emit a captured-text value as canonical quoted wire: ", \, and the
// whitespace escapes unescapeStringLiteral reads (\n \t \r) round-trip.
fn wireEmitQuoted(out: *std.ArrayList(u8), allocator: std.mem.Allocator, text: []const u8) void {
    out.append(allocator, '"') catch unreachable;
    for (text) |c| {
        switch (c) {
            '"' => out.appendSlice(allocator, "\\\"") catch unreachable,
            '\\' => out.appendSlice(allocator, "\\\\") catch unreachable,
            '\n' => out.appendSlice(allocator, "\\n") catch unreachable,
            '\t' => out.appendSlice(allocator, "\\t") catch unreachable,
            '\r' => out.appendSlice(allocator, "\\r") catch unreachable,
            else => out.append(allocator, c) catch unreachable,
        }
    }
    out.append(allocator, '"') catch unreachable;
}

// True when captured text is one bare token a reference could spell:
// identifier-start, then bare-value chars only (`r9`, `r9.flights`). A
// number or keyword starts wrong or is exempted downstream; prose and
// bracketed data contain capture-only characters and never reach here.
fn wireIsBareRef(t: []const u8) bool {
    if (t.len == 0 or !wireIdentStart(t[0])) return false;
    for (t) |c| {
        if (!wireBareValueChar(c)) return false;
    }
    return true;
}

// Scan a captured-text value: balanced to a depth-0 ',' or ')' — strings and
// bracket pairs inside the text are data, not delimiters.
fn wireScanCaptured(s: []const u8, i: *usize) []const u8 {
    const start = i.*;
    var depth: i32 = 0;
    var quote: ?u8 = null;
    while (i.* < s.len) {
        const c = s[i.*];
        if (quote) |q| {
            if (c == '\\' and i.* + 1 < s.len) {
                i.* += 2;
                continue;
            }
            if (c == q) quote = null;
            i.* += 1;
            continue;
        }
        // Only '"' quotes — captured text is prose/code, and an apostrophe
        // in it ("it's stuck") is a character, not a delimiter.
        if (c == '"') {
            quote = c;
        } else if (c == '(' or c == '{' or c == '[') {
            depth += 1;
        } else if (c == ']' or c == '}') {
            if (depth > 0) depth -= 1;
        } else if (c == ')') {
            if (depth == 0) break;
            depth -= 1;
        } else if (c == ',' and depth == 0) {
            break;
        }
        i.* += 1;
    }
    return s[start..i.*];
}
