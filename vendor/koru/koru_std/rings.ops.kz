// Koru Standard Library: the name-addressed ring ops — joined via
// `~part ops` in rings.kz.
//
//   std/rings:enqueue(feed, v) | ok |> .. | full |> ..
//   std/rings:dequeue(feed)    | some v |> .. | none |> ..
//
// The subject is the ring's declared name, not a handle: a ring is a named
// static (the std/store model), shared across flows and threads by
// construction. Each site rewrites to the tor `std/rings:new` generated —
// `__ring_<n>_enqueue` / `__ring_<n>_dequeue` — so the call carries the
// element type the declaration fixed, and the site's `|` arms ride
// untouched.
//
// Ordering law (same as store/channel): the declaration precedes its uses
// in document order — transforms run in source order and a site finds the
// ring by the `__rings_decl_<n>` marker `new` emitted.
//
// No top-level imports — part files share the merged module's consts.

fn ringStep(
    allocator: std.mem.Allocator,
    program: *const ast.Program,
    flow: *const ast.Flow,
    invocation: *const ast.Invocation,
    reporter: anytype,
    verb: []const u8,
) ast.SiteResult {
    // Args: the ring name is positional; the value is `v:`-labeled (the
    // std/list convention — a second bare positional names no parameter and
    // the pun law refuses it before transforms run).
    var ring_name: []const u8 = "";
    var bare_value: ?[]const u8 = null;
    var labeled_value: ?[]const u8 = null;
    var bad_label: ?[]const u8 = null;
    for (invocation.args) |a| {
        if (a.source_value != null) continue;
        if (R.isLabelled(a)) {
            const an = std.mem.trim(u8, a.name, " \t");
            if (std.mem.eql(u8, an, "v") or std.mem.eql(u8, an, "value")) {
                if (labeled_value == null) {
                    labeled_value = std.mem.trim(u8, a.value, " \t");
                    continue;
                }
            }
            bad_label = an;
        } else if (ring_name.len == 0) {
            ring_name = R.stripQuotes(std.mem.trim(u8, a.value, " \t"));
        } else if (bare_value == null) {
            bare_value = std.mem.trim(u8, a.value, " \t");
        }
    }
    if (ring_name.len == 0) {
        return .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/rings:{s} takes the ring by name — `{s}(feed)`; the ring is declared `std/rings:new(feed, capacity: N) {{ value: Type }}`", .{ verb, verb }) };
    }
    if (R.markerElem(allocator, program, ring_name) == null) {
        return .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/rings:{s}: no ring named '{s}' — declare it `std/rings:new({s}, capacity: N) {{ value: Type }}` above this use", .{ verb, ring_name, ring_name }) };
    }

    var target: []const u8 = "";
    var call_args: []const ast.Arg = &.{};
    if (std.mem.eql(u8, verb, "enqueue")) {
        if (bad_label) |bl| {
            return .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/rings:enqueue({s}): '{s}:' isn't a ring argument — the value is `v:`-labeled: `enqueue({s}, v: x)`", .{ ring_name, bl, ring_name }) };
        }
        const value = labeled_value orelse bare_value orelse {
            return .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/rings:enqueue({s}) needs the value — `enqueue({s}, v: x)`", .{ ring_name, ring_name }) };
        };
        const ca = allocator.alloc(ast.Arg, 1) catch unreachable;
        ca[0] = ast.Arg{
            .name = allocator.dupe(u8, "value") catch unreachable,
            .value = allocator.dupe(u8, value) catch unreachable,
            .had_explicit_label = true,
        };
        call_args = ca;
        target = std.fmt.allocPrint(allocator, "__ring_{s}_enqueue", .{ring_name}) catch unreachable;
    } else {
        if (bad_label orelse labeled_value) |_| {
            const bl = bad_label orelse "v";
            return .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/rings:dequeue({s}): '{s}:' isn't a ring argument — `dequeue({s})`", .{ ring_name, bl, ring_name }) };
        }
        if (bare_value != null) {
            return .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, "std/rings:dequeue({s}) takes no value — `dequeue({s}) | some v |> ...`", .{ ring_name, ring_name }) };
        }
        target = std.fmt.allocPrint(allocator, "__ring_{s}_dequeue", .{ring_name}) catch unreachable;
    }

    const segs = allocator.alloc([]const u8, 1) catch unreachable;
    segs[0] = target;
    const call_inv = ast.Invocation{
        .path = ast.DottedPath{
            .module_qualifier = allocator.dupe(u8, RH.ringHome(allocator, program, ring_name) orelse flow.module) catch unreachable,
            .segments = segs,
        },
        .args = call_args,
    };

    // Mid-chain site: swap this continuation's node for the generated call;
    // the site's `|` arms ride untouched.
    if (invocation != flow.inv()) {
        return .{ .replacement_node = .{ .node = ast.Node{ .invocation = call_inv } } };
    }

    const conts = allocator.alloc(ast.Continuation, flow.body.continuations.len) catch unreachable;
    for (flow.body.continuations, 0..) |*c, i| {
        conts[i] = ast_functional.cloneContinuation(allocator, c) catch unreachable;
    }
    return .{ .replacement = ast.Item{ .flow = ast.Flow{
        .body = ast.rootSite(call_inv, conts, flow.location),
        .pre_label = null,
        .impl_of = flow.impl_of,
        .super_shape = null,
        .inline_body = null,
        .preamble_code = null,
        .is_pure = false,
        .is_transitively_pure = false,
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } } };
}

~[keyword|comptime|transform]pub tor enqueue {
    expr: Expression,
    invocation: *const Invocation,
    item: *const std/compiler:Item,
    program: *const std/compiler:Program,
    reporter: *std/compiler:ErrorReporter,
    allocator: std.mem.Allocator
} -> SiteResult

~[transform]proc enqueue|zig {
    if (item.* != .flow) @panic("rings:enqueue transform: containing item is not a flow - walker dispatch contract broken");
    return .{ .transformed = ringStep(allocator, program, &item.flow, invocation, reporter, "enqueue") };
}

~[keyword|comptime|transform]pub tor dequeue {
    expr: Expression,
    invocation: *const Invocation,
    item: *const std/compiler:Item,
    program: *const std/compiler:Program,
    reporter: *std/compiler:ErrorReporter,
    allocator: std.mem.Allocator
} -> SiteResult

~[transform]proc dequeue|zig {
    if (item.* != .flow) @panic("rings:dequeue transform: containing item is not a flow - walker dispatch contract broken");
    return .{ .transformed = ringStep(allocator, program, &item.flow, invocation, reporter, "dequeue") };
}
