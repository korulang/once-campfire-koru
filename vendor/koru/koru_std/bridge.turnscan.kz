// Koru Standard Library: the `turnscan` part of bridge.kz — per-line
// classification for the turn segmenter. Joined via `~part turnscan` in
// bridge.kz; merged into the bridge module at load.

/// Invocation-shaped: a `|` arm, a `tor ` define, or `name(` / `name:` —
/// the lines that open a new wire item even inside a `verb:` prose block.
fn isInvocationHead(line: []const u8) bool {
    if (std.mem.startsWith(u8, line, "|") or std.mem.startsWith(u8, line, "tor ")) return true;
    var k: usize = 0;
    if (k < line.len and !Runtime.wireIdentStart(line[k])) return false;
    while (k < line.len and Runtime.wireIdentChar(line[k])) k += 1;
    while (k < line.len and (line[k] == ' ' or line[k] == '\t')) k += 1;
    return k < line.len and (line[k] == '(' or line[k] == ':');
}

/// `name: <text>` — a colon-form invocation head: ident, colon, prose on the
/// same line. Bare `name:` alone reads as a define's impl head, not prose.
fn isColonHead(line: []const u8) bool {
    var k: usize = 0;
    if (k < line.len and !Runtime.wireIdentStart(line[k])) return false;
    while (k < line.len and Runtime.wireIdentChar(line[k])) k += 1;
    while (k < line.len and (line[k] == ' ' or line[k] == '\t')) k += 1;
    if (k >= line.len or line[k] != ':') return false;
    while (k < line.len and (line[k] == ' ' or line[k] == '\t')) k += 1;
    return k < line.len;
}

/// Update delimiter/string state across one raw line. Strings (with `\`
/// escapes) and backtick spans are opaque: delimiters inside them are data.
fn scanLineChars(raw: []const u8, paren: *i32, brace: *i32, bracket: *i32, in_string: *?u8) void {
    var in_backtick = false;
    var k: usize = 0;
    while (k < raw.len) {
        const c = raw[k];
        if (in_string.* == null and c == '`') {
            in_backtick = !in_backtick;
            k += 1;
            continue;
        }
        if (in_backtick) {
            k += 1;
            continue;
        }
        if (in_string.*) |q| {
            if (c == '\\' and k + 1 < raw.len) {
                k += 2;
                continue;
            }
            if (c == q) in_string.* = null;
            k += 1;
            continue;
        }
        if (c == '"') {
            in_string.* = c;
        } else if (c == '(') {
            paren.* += 1;
        } else if (c == ')') {
            paren.* -= 1;
        } else if (c == '{') {
            brace.* += 1;
        } else if (c == '}') {
            brace.* -= 1;
        } else if (c == '[') {
            bracket.* += 1;
        } else if (c == ']') {
            bracket.* -= 1;
        }
        k += 1;
    }
}
