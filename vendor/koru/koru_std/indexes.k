// Koru Standard Library: std/indexes — first-class index declarations.
//
// `std/indexes:store(<store>, <column>)` is pure AST-data — the kernel:shape
// pattern. A [norun] tor claims the site, it never executes, and the node
// stays in program.items through every transform stage: the AST is the
// registry. The indexed organ's transforms discover the declaration on
// their program walk and emit the key→member buckets `! first` and `! query` consume.
//
// Lives at `indexes` not `index`: `std/index` is unreachable — index.kz IS
// the `std` root itself, and `index/` collides with it (KORU200).

[norun]pub tor store {
    expr: Expression,
    source: Source
}
