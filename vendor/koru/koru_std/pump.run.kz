// Koru Standard Library: the `run` part of pump — joined via
// `~part run` in pump.kz; members land in koru_pump.
//
// PUMP.RUN — drive a declared pump until every participant drains.
//
//   std/pump:run(main)
//   ! idle |> ...
//
// Enumerates the joined `__pump_<name>_step_<i>` units and emits
// `__pump_run_<name>`: while any participant's `live` counts rows, step each
// in join order. A pass with zero progress fires `! idle` — armed, the arm
// runs in the loop; unarmed, the union wait collects every `wait` unit's
// interests and polls once, or breathes 1ms when nothing was declared.
//
// Retirement: a participant may emit `__pump_<name>_retired_<i>` — fired by
// the driver exactly once, on the first pass whose `live` answers 0, ahead
// of `| drained`. This is where a captured participant's run-terminal arms
// (`| stopped`, `| done`) land. It requires `live` — an immortal participant
// never retires.
// ----------------------------------------------------------------------------

~[keyword|comptime|transform]pub tor run {
    expr: Expression,
    invocation: *const Invocation,
    item: *const std/compiler:Item,
    program: *const std/compiler:Program,
    reporter: *std/compiler:ErrorReporter,
    allocator: std.mem.Allocator
} -> SiteResult

~[transform]proc run|zig {
    const ast_functional = @import("ast_functional");
    const flow = siteFlow(item, "pump:run transform: containing item is not a flow - walker dispatch contract broken");
    const host_is_js = std.mem.eql(u8, CompilerEnv.lang, "js");
    const proc_target = if (host_is_js) "js" else "zig";

    const pump_name = siteName(invocation);
    if (pump_name.len == 0) {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, PMRun.run_needs_name, .{}) } };
    }
    if (!PH.markerExists(program, PH.markerDecl(allocator, "decl", pump_name))) {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, PMRun.run_no_pump, .{ pump_name, pump_name, pump_name, pump_name }) } };
    }
    if (PH.markerExists(program, PH.markerDecl(allocator, "ran", pump_name))) {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, PMRun.run_already_ran, .{ pump_name, pump_name }) } };
    }

    // Enumerate joins by convention: step_0, step_1, ... until a gap.
    const Join = struct { idx: usize, has_live: bool, has_wait: bool, wait_bind: []const u8, has_retire: bool };
    var joins = std.ArrayList(Join).initCapacity(allocator, 4) catch unreachable;
    var ji: usize = 0;
    while (PH.findDecl(allocator, program, std.fmt.allocPrint(allocator, "__pump_{s}_step_{d}", .{ pump_name, ji }) catch unreachable) != null) {
        var j = Join{ .idx = ji, .has_live = false, .has_wait = false, .wait_bind = "i", .has_retire = false };
        j.has_live = PH.findDecl(allocator, program, std.fmt.allocPrint(allocator, "__pump_{s}_live_{d}", .{ pump_name, ji }) catch unreachable) != null;
        const wname = std.fmt.allocPrint(allocator, "__pump_{s}_wait_{d}", .{ pump_name, ji }) catch unreachable;
        if (PH.findEventDecl(program, wname)) |wd| {
            j.has_wait = true;
            if (wd.input.fields.len == 1) j.wait_bind = wd.input.fields[0].name;
        }
        j.has_retire = PH.findDecl(allocator, program, std.fmt.allocPrint(allocator, "__pump_{s}_retired_{d}", .{ pump_name, ji }) catch unreachable) != null;
        joins.append(allocator, j) catch unreachable;
        ji += 1;
    }
    var any_wait = false;
    var wait_no_live: usize = 0;
    var any_retire = false;
    for (joins.items) |j| {
        if (j.has_wait) {
            any_wait = true;
            if (!j.has_live) wait_no_live += 1;
        }
        if (j.has_retire) {
            if (!j.has_live) {
                return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, PMRun.run_retire_needs_live, .{ pump_name, j.idx, pump_name, j.idx }) } };
            }
            any_retire = true;
        }
    }

    var appended_items = std.ArrayList(ast.Item).initCapacity(allocator, 8) catch unreachable;
    appended_items.append(allocator, PH.markerItem(allocator, flow, PH.markerDecl(allocator, "ran", pump_name))) catch unreachable;

    const run_name = std.fmt.allocPrint(allocator, "__pump_run_{s}", .{pump_name}) catch unreachable;
    const retain_ann = blk_ra: {
        const anns = allocator.alloc([]const u8, 1) catch unreachable;
        anns[0] = allocator.dupe(u8, "retain") catch unreachable;
        break :blk_ra anns;
    };
    const run_branches = allocator.alloc(ast.Branch, 1) catch unreachable;
    run_branches[0] = ast.Branch{
        .name = "idle",
        .payload = ast.Shape{ .fields = &[_]ast.Field{} },
        .is_optional = true,
        .kind = .effect,
    };
    appended_items.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
        .path = PH.mkPath(allocator, ast_functional.moduleHome(program, flow) orelse flow.module, run_name),
        .input = ast.Shape{ .fields = &[_]ast.Field{} },
        .branches = run_branches,
        .is_public = false,
        .is_implicit_flow = false,
        .annotations = retain_ann,
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } }) catch unreachable;

    const q = PH.eventQual(allocator, ast_functional.moduleHome(program, flow) orelse flow.module, program.main_module_name);
    var rb = std.ArrayList(u8).initCapacity(allocator, 256 + joins.items.len * 128) catch unreachable;
    if (host_is_js) {
        if (any_retire) {
            // One-shot retirement flags — `__pump_<name>_retired_<i>` fires on
            // the first pass its `live` answers 0, then never again.
            rb.appendSlice(allocator, "let __koru_retired = [") catch unreachable;
            for (joins.items, 0..) |_, ri| {
                rb.appendSlice(allocator, if (ri == 0) "false" else ", false") catch unreachable;
            }
            rb.appendSlice(allocator, "];\n") catch unreachable;
        }
        rb.appendSlice(allocator, "while (true) {\n    let __koru_live = 0;\n") catch unreachable;
        for (joins.items) |j| {
            if (j.has_retire) {
                rb.appendSlice(allocator, std.fmt.allocPrint(allocator, "    const __koru_l{d} = {s}__pump_{s}_live_{d}_event.handler({{}});\n    __koru_live += __koru_l{d};\n    if (__koru_l{d} === 0 && !__koru_retired[{d}]) {{ __koru_retired[{d}] = true; {s}__pump_{s}_retired_{d}_event.handler({{}}); }}\n", .{ j.idx, q, pump_name, j.idx, j.idx, j.idx, j.idx, j.idx, q, pump_name, j.idx }) catch unreachable) catch unreachable;
            } else if (j.has_live) {
                rb.appendSlice(allocator, std.fmt.allocPrint(allocator, "    __koru_live += {s}__pump_{s}_live_{d}_event.handler({{}});\n", .{ q, pump_name, j.idx }) catch unreachable) catch unreachable;
            } else {
                rb.appendSlice(allocator, "    __koru_live += 1;\n") catch unreachable;
            }
        }
        rb.appendSlice(allocator, "    if (__koru_live === 0) break;\n    let __koru_worked = 0;\n") catch unreachable;
        for (joins.items) |j| {
            rb.appendSlice(allocator, std.fmt.allocPrint(allocator, "    __koru_worked += {s}__pump_{s}_step_{d}_event.handler({{}});\n", .{ q, pump_name, j.idx }) catch unreachable) catch unreachable;
        }
        rb.appendSlice(allocator, "    if (__koru_worked === 0) idle();\n}\n") catch unreachable;
        if (PH.findDecl(allocator, program, PH.markerDecl(allocator, "drained", pump_name))) |dp| {
            _ = dp;
            rb.appendSlice(allocator, std.fmt.allocPrint(allocator, "{s}__pump_drained_{s}_event.handler({{}});\n", .{ q, pump_name }) catch unreachable) catch unreachable;
        }
        rb.appendSlice(allocator, "return;\n") catch unreachable;
    } else {
        if (any_retire) {
            rb.appendSlice(allocator, std.fmt.allocPrint(allocator, "var __koru_retired = [_]bool{{false}} ** {d};\n", .{joins.items.len}) catch unreachable) catch unreachable;
        }
        rb.appendSlice(allocator, "while (true) {\n    var __koru_live: i64 = 0;\n") catch unreachable;
        for (joins.items) |j| {
            if (j.has_retire) {
                rb.appendSlice(allocator, std.fmt.allocPrint(allocator, "    const __koru_l{d}: i64 = {s}__pump_{s}_live_{d}_event.handler(.{{}});\n    __koru_live += __koru_l{d};\n    if (__koru_l{d} == 0 and !__koru_retired[{d}]) {{ __koru_retired[{d}] = true; {s}__pump_{s}_retired_{d}_event.handler(.{{}}); }}\n", .{ j.idx, q, pump_name, j.idx, j.idx, j.idx, j.idx, j.idx, q, pump_name, j.idx }) catch unreachable) catch unreachable;
            } else if (j.has_live) {
                rb.appendSlice(allocator, std.fmt.allocPrint(allocator, "    __koru_live += {s}__pump_{s}_live_{d}_event.handler(.{{}});\n", .{ q, pump_name, j.idx }) catch unreachable) catch unreachable;
            } else {
                rb.appendSlice(allocator, "    __koru_live += 1;\n") catch unreachable;
            }
        }
        rb.appendSlice(allocator, "    if (__koru_live == 0) break;\n    var __koru_worked: i64 = 0;\n") catch unreachable;
        for (joins.items) |j| {
            rb.appendSlice(allocator, std.fmt.allocPrint(allocator, "    __koru_worked += {s}__pump_{s}_step_{d}_event.handler(.{{}});\n", .{ q, pump_name, j.idx }) catch unreachable) catch unreachable;
        }
        rb.appendSlice(allocator, "    if (__koru_worked == 0) { if (@hasDecl(__H, \"idle\")) { idle(); } else {\n") catch unreachable;
        if (any_wait) {
            // The union wait: one poll over every joined `wait` unit's live
            // instances, capped by the nearest `wait_ns`. Units normalize
            // absent fields to sentinels (fd = -1, wait_ns = maxInt = none);
            // a pass with no declared interests breathes 1ms.
            rb.appendSlice(allocator, std.fmt.allocPrint(allocator,
                \\        var __koru_wait_ns: i128 = @import("std").math.maxInt(i128);
                \\        const __koru_pfds = @import("std").heap.page_allocator.alloc(@import("std").posix.pollfd, @as(usize, @intCast(@max(__koru_live + {d}, 1)))) catch unreachable;
                \\        defer @import("std").heap.page_allocator.free(__koru_pfds);
                \\        var __koru_nfd: usize = 0;
                \\
            , .{wait_no_live}) catch unreachable) catch unreachable;
            for (joins.items) |j| {
                if (!j.has_wait) continue;
                const live_expr = if (j.has_live)
                    std.fmt.allocPrint(allocator, "@as(usize, @intCast({s}__pump_{s}_live_{d}_event.handler(.{{}})))", .{ q, pump_name, j.idx }) catch unreachable
                else
                    std.fmt.allocPrint(allocator, "@as(usize, 1)", .{}) catch unreachable;
                rb.appendSlice(allocator, std.fmt.allocPrint(allocator,
                    \\        for (0..{s}) |__koru_wi| {{
                    \\            const __koru_w = {s}__pump_{s}_wait_{d}_event.handler(.{{ .{s} = @intCast(__koru_wi) }});
                    \\            if (__koru_w.fd >= 0) {{ __koru_pfds[__koru_nfd] = .{{ .fd = __koru_w.fd, .events = @import("std").posix.POLL.IN, .revents = 0 }}; __koru_nfd += 1; }}
                    \\            if (__koru_w.wait_ns < __koru_wait_ns) __koru_wait_ns = __koru_w.wait_ns;
                    \\        }}
                    \\
                , .{ live_expr, q, pump_name, j.idx, j.wait_bind }) catch unreachable) catch unreachable;
            }
            rb.appendSlice(allocator,
                \\        if (__koru_nfd == 0 and __koru_wait_ns == @import("std").math.maxInt(i128)) {
                \\            @import("std").Thread.sleep(1_000_000);
                \\        } else {
                \\            var __koru_ms: i32 = -1;
                \\            if (__koru_wait_ns != @import("std").math.maxInt(i128)) __koru_ms = @intCast(@min(@as(i128, @import("std").math.maxInt(i32)) * 1_000_000, @max(@as(i128, 0), __koru_wait_ns)) / 1_000_000);
                \\            if (__koru_nfd > 0) {
                \\                _ = @import("std").posix.poll(__koru_pfds[0..__koru_nfd], __koru_ms) catch 0;
                \\            } else if (__koru_ms >= 0) {
                \\                @import("std").Thread.sleep(@as(u64, @intCast(__koru_ms)) * 1_000_000);
                \\            }
                \\        }
                \\
            ) catch unreachable;
        } else {
            rb.appendSlice(allocator, "        @import(\"std\").Thread.sleep(1_000_000);\n") catch unreachable;
        }
        rb.appendSlice(allocator, "    } }\n}\n") catch unreachable;
        if (PH.findDecl(allocator, program, PH.markerDecl(allocator, "drained", pump_name)) != null) {
            rb.appendSlice(allocator, std.fmt.allocPrint(allocator, "{s}__pump_drained_{s}_event.handler(.{{}});\n", .{ q, pump_name }) catch unreachable) catch unreachable;
        }
        rb.appendSlice(allocator, "return;\n") catch unreachable;
    }
    appended_items.append(allocator, ast.Item{ .proc_decl = ast.ProcDecl{
        .path = PH.mkPath(allocator, ast_functional.moduleHome(program, flow) orelse flow.module, run_name),
        .body = ast.Source{ .text = rb.toOwnedSlice(allocator) catch unreachable, .location = flow.location, .scope = .{ .bindings = &[_]ast.ScopeBinding{} }, .phantom_type = null },
        .annotations = retain_ann,
        .target = allocator.dupe(u8, proc_target) catch unreachable,
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } }) catch unreachable;

    // Rewrite the site to the generated loop call, carrying the `! idle` arm.
    const call_inv = ast.Invocation{ .path = PH.mkPath(allocator, ast_functional.moduleHome(program, flow) orelse flow.module, run_name), .args = &[_]ast.Arg{} };
    const conts: []ast.Continuation = blk: {
        const cloned = allocator.alloc(ast.Continuation, flow.body.continuations.len) catch unreachable;
        for (flow.body.continuations, 0..) |*c, i| {
            cloned[i] = ast_functional.cloneContinuation(allocator, c) catch unreachable;
        }
        break :blk cloned;
    };
    return .{ .transformed = .{ .replacement = ast.Item{ .flow = ast.Flow{
        .body = ast.rootSite(call_inv, conts, flow.location),
        .pre_label = null,
        .impl_of = flow.impl_of,
        .super_shape = null,
        .inline_body = null,
        .preamble_code = null,
        .is_pure = false,
        .is_transitively_pure = false,
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } }, .appended = appended_items.toOwnedSlice(allocator) catch unreachable } };
}
