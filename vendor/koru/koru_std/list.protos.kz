// Koru Standard Library: proto-resolution machinery for the list
// module — joined via `~part protos` in list.kz; members land in
// koru_list.
//
// Reads proto declaration flows (live and erased-marker) out of the
// program AST and flattens their field sets — `<:` parents merge ahead
// of the block (proto.resolve.kz owns the declaration-side gate).

/// Bare entry name a proto-qualified element expression names, or null for a
/// primitive. `i64` -> null; `Engine` -> "Engine"; `app/car:Engine` -> "Engine".
fn protoEntryName(alloc: std.mem.Allocator, elem: []const u8) ?[]const u8 {
    const trimmed = std.mem.trim(u8, elem, " \t");
    if (trimmed.len == 0) return null;
    const name = if (std.mem.lastIndexOfScalar(u8, trimmed, ':')) |ci|
        std.mem.trim(u8, trimmed[ci + 1 ..], " \t")
    else
        trimmed;
    if (name.len == 0) return null;
    const primitives = [_][]const u8{ "i64", "i32", "i16", "i8", "u64", "u32", "u16", "u8", "f64", "f32", "bool", "usize", "string", "void", "char" };
    for (primitives) |p| {
        if (std.mem.eql(u8, name, p)) return null;
    }
    return alloc.dupe(u8, name) catch unreachable;
}

const ProtoFields = struct {
    names: []const []const u8,
    types: []const []const u8,
};

/// True when a continuation tree carries a `new-<elem>` invocation — the

fn declEntryName(inv: *const ast_find.Invocation) []const u8 {
    if (inv.args.len == 0) return "";
    const a0 = inv.args[0];
    if (a0.had_explicit_label) {
        const label = std.mem.trim(u8, a0.name, " \t");
        if (std.mem.endsWith(u8, label, "<"))
            return std.mem.trim(u8, label[0 .. label.len - 1], " \t");
        return label;
    }
    return inv.args[0].value;
}

/// The parent spec of an extending declaration — "Animal + Pet" — or null.
fn protoParentSpec(inv: *const ast_find.Invocation) ?[]const u8 {
    if (inv.args.len == 0) return null;
    const a0 = inv.args[0];
    if (!a0.had_explicit_label) return null;
    const label = std.mem.trim(u8, a0.name, " \t");
    if (!std.mem.endsWith(u8, label, "<")) return null;
    const v = std.mem.trim(u8, a0.value, " \t");
    return if (v.len > 0) v else null;
}

/// The proto declaration flow an element expression names. `elem` may be bare
/// (`Engine`) or module-qualified (`app/car:Engine`); the entry is matched on
/// the bare name, and a qualifier additionally requires the declaring module.
/// Duplicate names across the whole program are refused by the checker's proto
/// scan (the loud two-registrant wall), so a bare match is unambiguous.
fn findProtoDecl(prog: *const ast_find.Program, elem: []const u8) ?*const ast_find.Flow {
    const trimmed = std.mem.trim(u8, elem, " \t");
    const want_name = if (std.mem.lastIndexOfScalar(u8, trimmed, ':')) |ci|
        std.mem.trim(u8, trimmed[ci + 1 ..], " \t")
    else
        trimmed;
    var want_mod: ?[]const u8 = null;
    if (std.mem.lastIndexOfScalar(u8, trimmed, ':')) |ci| {
        const qual = std.mem.trim(u8, trimmed[0..ci], " \t");
        if (qual.len > 0) {
            const dotted = std.mem.replaceOwned(u8, std.heap.page_allocator, qual, "/", ".") catch unreachable;
            want_mod = dotted;
        }
    }
    const Finder = struct {
        fn invokesProto(f: *const ast_find.Flow, name: []const u8, mod: ?[]const u8) bool {
            const inv = f.inv();
            if (inv.path.segments.len != 1) return false;
            const verb = inv.path.segments[0];
            const mq = inv.path.module_qualifier orelse return false;
            // Two doors to the same registry entry: the original
            // `std/types:proto(Name)` verb form, and the default-door form
            // `std/proto(Name)` ≡ `std/proto:default(Name)` that the
            // default-event rule rewrites a bare module call into
            // (import_pipeline.zig rewriteDefaultEventCalls; the post-rewrite
            // mq is the canonical dotted path "std.proto").
            const types_door = std.mem.eql(u8, verb, "proto") and
                (std.mem.eql(u8, mq, "std.types") or std.mem.eql(u8, mq, "std/types"));
            const default_door = std.mem.eql(u8, verb, "default") and
                (std.mem.eql(u8, mq, "std.proto") or std.mem.eql(u8, mq, "std/proto"));
            if (!(types_door or default_door)) return false;
            if (inv.args.len == 0) return false;
            var nm = declEntryName(inv);
            if (nm.len >= 2 and nm[0] == '"' and nm[nm.len - 1] == '"') nm = nm[1 .. nm.len - 1];
            if (!std.mem.eql(u8, nm, name)) return false;
            if (mod) |m| {
                if (f.module.len > 0 and std.mem.eql(u8, f.module, m)) return true;
                return false;
            }
            return true;
        }
        fn findIn(items: []const ast_find.Item, name: []const u8, mod: ?[]const u8) ?*const ast_find.Flow {
            for (items) |pi| {
                switch (pi) {
                    .flow => |*f| {
                        if (invokesProto(f, name, mod)) return f;
                    },
                    .module_decl => |*m| {
                        if (findIn(m.items, name, mod)) |hit| return hit;
                    },
                    else => {},
                }
            }
            return null;
        }
    };
    return Finder.findIn(prog.items, want_name, want_mod);
}

/// True when the program carries the proto entry `elem` in EITHER of the two
/// forms the transform fixed point leaves behind: the declaration flow
/// (pre-erase) or the self-erased `// proto <Name>: ...` marker comment
/// (post-erase). Pass ordering decides which form a `std/list:new` site sees —
/// a proto declared EARLIER in the file erases first, and detection keyed on
/// the live flow alone then misroutes a proto element as a primitive
/// (`new-Engine` with no such tor → KORU040).
fn programHasProto(prog: *const ast_find.Program, elem: []const u8) bool {
    if (findProtoDecl(prog, elem)) |_| return true;
    const trimmed = std.mem.trim(u8, elem, " \t");
    const want_name = if (std.mem.lastIndexOfScalar(u8, trimmed, ':')) |ci|
        std.mem.trim(u8, trimmed[ci + 1 ..], " \t")
    else
        trimmed;
    var want_mod: ?[]const u8 = null;
    if (std.mem.lastIndexOfScalar(u8, trimmed, ':')) |ci| {
        const qual = std.mem.trim(u8, trimmed[0..ci], " \t");
        if (qual.len > 0) {
            want_mod = std.mem.replaceOwned(u8, std.heap.page_allocator, qual, "/", ".") catch unreachable;
        }
    }
    const Marker = struct {
        fn matches(ic: *const ast_find.InlineCode, name: []const u8, mod: ?[]const u8) bool {
            const prefix = "// proto ";
            if (!std.mem.startsWith(u8, ic.code, prefix)) return false;
            const colon = std.mem.indexOfScalar(u8, ic.code, ':') orelse return false;
            if (!std.mem.eql(u8, std.mem.trim(u8, ic.code[prefix.len..colon], " \t"), name)) return false;
            if (mod) |m| {
                if (ic.module.len > 0 and std.mem.eql(u8, ic.module, m)) return true;
                return false;
            }
            return true;
        }
        fn find(items: []const ast_find.Item, name: []const u8, mod: ?[]const u8) bool {
            for (items) |pi| {
                switch (pi) {
                    .inline_code => |*ic| {
                        if (matches(ic, name, mod)) return true;
                    },
                    .module_decl => |*m| {
                        if (find(m.items, name, mod)) return true;
                    },
                    else => {},
                }
            }
            return false;
        }
    };
    return Marker.find(prog.items, want_name, want_mod);
}

/// The fields of a proto declaration flow, parsed from its `source:` argument's
/// text (`rpm: i32, serial: string`). A live `<:` decl's block carries only
/// the LOCAL fields — the parents' sets are unioned ahead of them (markers
/// arrive already flat). `ext_stack` guards the walk: an ungated `A <: B /
/// B <: A` pair truncates instead of hanging — the declaration gate owns the
/// loud refusal; this walk just never loops.
fn protoFieldsOf(alloc: std.mem.Allocator, prog: *const ast_find.Program, decl: *const ast_find.Flow, ext_stack: *std.ArrayList([]const u8)) ProtoFields {
    const inv = decl.inv();
    var src: ?[]const u8 = null;
    for (inv.args) |a| {
        if (a.source_value) |sv| {
            src = sv.text;
            break;
        }
    }
    const text = src orelse "";
    var out_names = std.ArrayList([]const u8).initCapacity(alloc, 8) catch unreachable;
    var out_types = std.ArrayList([]const u8).initCapacity(alloc, 8) catch unreachable;
    if (protoParentSpec(inv)) |spec| {
        const entry = declEntryName(inv);
        var on_stack = false;
        for (ext_stack.items) |s| {
            if (std.mem.eql(u8, s, entry)) {
                on_stack = true;
                break;
            }
        }
        if (!on_stack) {
            ext_stack.append(alloc, entry) catch unreachable;
            var ptoks = std.mem.tokenizeScalar(u8, spec, '+');
            while (ptoks.next()) |praw| {
                const psub = protoFieldsOfProgramFlatInner(alloc, prog, std.mem.trim(u8, praw, " \t"), ext_stack);
                for (psub.names, psub.types) |pn, pt| {
                    var dup = false;
                    for (out_names.items) |en| {
                        if (std.mem.eql(u8, en, pn)) {
                            dup = true;
                            break;
                        }
                    }
                    if (!dup) {
                        out_names.append(alloc, pn) catch unreachable;
                        out_types.append(alloc, pt) catch unreachable;
                    }
                }
            }
            _ = ext_stack.pop();
        }
    }
    var lines2 = std.mem.splitScalar(u8, text, '\n');
    while (lines2.next()) |line_raw| {
        const line = std.mem.trim(u8, line_raw, " \t\r,");
        if (line.len == 0) continue;
        const colon = std.mem.indexOfScalar(u8, line, ':') orelse continue;
        const fname = std.mem.trim(u8, line[0..colon], " \t");
        const ftype = std.mem.trim(u8, line[colon + 1 ..], " \t,");
        if (fname.len == 0 or ftype.len == 0) continue;
        var dup = false;
        for (out_names.items) |en| {
            if (std.mem.eql(u8, en, fname)) {
                dup = true;
                break;
            }
        }
        if (dup) continue;
        out_names.append(alloc, alloc.dupe(u8, fname) catch unreachable) catch unreachable;
        out_types.append(alloc, alloc.dupe(u8, ftype) catch unreachable) catch unreachable;
    }
    return .{ .names = out_names.toOwnedSlice(alloc) catch unreachable, .types = out_types.toOwnedSlice(alloc) catch unreachable };
}

/// The fields of a proto entry, from whichever representation the walker's
/// fixed point has left: the declaration flow (pre-self-erase) or the erased
/// `// proto Name: fields` comment. `elem` may be module-qualified. The flat
/// pairs expand nested compounds to dotted-leaf pairs on the way out.
fn protoFieldsOfProgram(alloc: std.mem.Allocator, prog: *const ast_find.Program, elem: []const u8) ProtoFields {
    const flat = protoFieldsOfProgramFlat(alloc, prog, elem);
    return expandNestedFields(alloc, prog, flat.names, flat.types);
}

/// Unexpanded fetch behind protoFieldsOfProgram: the entry's own pairs,
/// nested compounds left as named for the expansion walk. `<:` parents are
/// already merged — an extending entry's flat set IS the union.
fn protoFieldsOfProgramFlat(alloc: std.mem.Allocator, prog: *const ast_find.Program, elem: []const u8) ProtoFields {
    var ext_stack = std.ArrayList([]const u8).initCapacity(alloc, 4) catch unreachable;
    return protoFieldsOfProgramFlatInner(alloc, prog, elem, &ext_stack);
}

fn protoFieldsOfProgramFlatInner(alloc: std.mem.Allocator, prog: *const ast_find.Program, elem: []const u8, ext_stack: *std.ArrayList([]const u8)) ProtoFields {
    if (findProtoDecl(prog, elem)) |decl| {
        return protoFieldsOf(alloc, prog, decl, ext_stack);
    }
    const trimmed = std.mem.trim(u8, elem, " \t");
    const want_name = if (std.mem.lastIndexOfScalar(u8, trimmed, ':')) |ci|
        std.mem.trim(u8, trimmed[ci + 1 ..], " \t")
    else
        trimmed;
    const N = struct {
        fn find(items: []const ast_find.Item, name: []const u8, out: *?[]const u8) bool {
            for (items) |pi| {
                switch (pi) {
                    .inline_code => |ic| {
                        const c = ic.code;
                        const prefix = "// proto ";
                        if (std.mem.startsWith(u8, c, prefix)) {
                            if (std.mem.indexOfScalar(u8, c, ':')) |colon| {
                                if (std.mem.eql(u8, std.mem.trim(u8, c[prefix.len..colon], " \t"), name)) {
                                    out.* = c[colon + 1 ..];
                                    return true;
                                }
                            }
                        }
                    },
                    .module_decl => |*m| {
                        if (find(m.items, name, out)) return true;
                    },
                    else => {},
                }
            }
            return false;
        }
    };
    var rest: ?[]const u8 = null;
    _ = N.find(prog.items, want_name, &rest);
    const text = rest orelse return .{ .names = &.{}, .types = &.{} };
    // Parse the trailing fields text like a proto body source. The erased
    // marker is ONE line (`// proto Name: f: t, g: u`), so fields separate on
    // ',' as well as '\n'.
    var count: usize = 0;
    var lines1 = std.mem.tokenizeAny(u8, text, "\n,");
    while (lines1.next()) |line_raw| {
        const line = std.mem.trim(u8, line_raw, " \t\r,");
        if (line.len == 0) continue;
        const colon = std.mem.indexOfScalar(u8, line, ':') orelse continue;
        const fname = std.mem.trim(u8, line[0..colon], " \t");
        const ftype = std.mem.trim(u8, line[colon + 1 ..], " \t,");
        if (fname.len > 0 and ftype.len > 0) count += 1;
    }
    const names = alloc.alloc([]const u8, count) catch unreachable;
    const types = alloc.alloc([]const u8, count) catch unreachable;
    var w: usize = 0;
    var lines2 = std.mem.tokenizeAny(u8, text, "\n,");
    while (lines2.next()) |line_raw| {
        const line = std.mem.trim(u8, line_raw, " \t\r,");
        if (line.len == 0) continue;
        const colon = std.mem.indexOfScalar(u8, line, ':') orelse continue;
        const fname = std.mem.trim(u8, line[0..colon], " \t");
        const ftype = std.mem.trim(u8, line[colon + 1 ..], " \t,");
        if (fname.len == 0 or ftype.len == 0) continue;
        names[w] = alloc.dupe(u8, fname) catch unreachable;
        types[w] = alloc.dupe(u8, ftype) catch unreachable;
        w += 1;
    }
    return .{ .names = names[0..w], .types = types[0..w] };
}

/// Nested-compound expansion: flatten compound-typed fields to dotted-leaf
/// pairs (`pos: Position` with `x`,`y` becomes `pos.x`, `pos.y`), recursing
/// to any depth. Terminals and scalars are leaves and pass through untouched;
/// an ftype resolving to no compound is a leaf by definition — unknown names
/// are the declaration gate's refusal, never this walk's. A name already on
/// the expansion stack passes through unexpanded: unreachable while the gate
/// refuses cycles, kept purely so a walk over unvalidated declarations can
/// never hang (the gate's voice, which always runs, wins regardless).
/// Identity rides the paths for free: terminal leaves keep their global
/// names, raw leaves stay distinct per expansion path.
fn expandNestedFields(alloc: std.mem.Allocator, prog: *const ast_find.Program, names: []const []const u8, types: []const []const u8) ProtoFields {
    var out_names = std.ArrayList([]const u8).initCapacity(alloc, names.len) catch unreachable;
    var out_types = std.ArrayList([]const u8).initCapacity(alloc, types.len) catch unreachable;
    var stack = std.ArrayList([]const u8).initCapacity(alloc, 4) catch unreachable;
    for (names, types) |fname, ftype| {
        expandPair(alloc, prog, "", fname, ftype, &stack, &out_names, &out_types);
    }
    return .{ .names = out_names.toOwnedSlice(alloc) catch unreachable, .types = out_types.toOwnedSlice(alloc) catch unreachable };
}

fn expandPair(alloc: std.mem.Allocator, prog: *const ast_find.Program, prefix: []const u8, fname: []const u8, ftype: []const u8, stack: *std.ArrayList([]const u8), out_names: *std.ArrayList([]const u8), out_types: *std.ArrayList([]const u8)) void {
    const full = if (prefix.len == 0)
        alloc.dupe(u8, fname) catch unreachable
    else
        std.fmt.allocPrint(alloc, "{s}{s}", .{ prefix, fname }) catch unreachable;
    const bare = if (std.mem.lastIndexOfScalar(u8, ftype, ':')) |ci|
        std.mem.trim(u8, ftype[ci + 1 ..], " \t")
    else
        std.mem.trim(u8, ftype, " \t");
    for (stack.items) |s| {
        if (std.mem.eql(u8, s, bare)) {
            out_names.append(alloc, full) catch unreachable;
            out_types.append(alloc, ftype) catch unreachable;
            return;
        }
    }
    const sub = protoFieldsOfProgramFlat(alloc, prog, ftype);
    if (sub.names.len == 0) {
        out_names.append(alloc, full) catch unreachable;
        out_types.append(alloc, ftype) catch unreachable;
        return;
    }
    stack.append(alloc, bare) catch unreachable;
    const inner = std.fmt.allocPrint(alloc, "{s}.", .{full}) catch unreachable;
    for (sub.names, sub.types) |sn, st| {
        expandPair(alloc, prog, inner, sn, st, stack, out_names, out_types);
    }
    _ = stack.pop();
}

/// The element a container handle was bound from, found in the enclosing flow:
/// a `std/list:new(<elem>)` invocation whose binding branch carries the handle.
/// The new transform rewrites `new` -> `new-<elem>` in place, so the scan keys
/// on the REWRITTEN segment prefix.



/// Zig type for a proto field type string (`string` lowers at the emission
/// boundary; the struct body needs the Zig slice form today). `ref(X)`
/// lowers to the row-handle material — the target name lives in the marker
/// for checkers, the column is i64.
fn elementZigType(alloc: std.mem.Allocator, ftype: []const u8) []const u8 {
    const t = std.mem.trim(u8, ftype, " \t");
    if (std.mem.eql(u8, t, "string")) return alloc.dupe(u8, "[]const u8") catch unreachable;
    if (t.len > 5 and std.mem.startsWith(u8, t, "ref(") and t[t.len - 1] == ')')
        return alloc.dupe(u8, "i64") catch unreachable;
    return alloc.dupe(u8, t) catch unreachable;
}

/// Koru-level type for a proto field on a synthesized tor's input shape —
/// `ref(X)` is i64 there too (the handle), everything else verbatim.
fn fieldKoruType(ftype: []const u8) []const u8 {
    const t = std.mem.trim(u8, ftype, " \t");
    if (t.len > 5 and std.mem.startsWith(u8, t, "ref(") and t[t.len - 1] == ')') return "i64";
    return t;
}

