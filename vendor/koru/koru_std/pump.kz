// Koru Standard Library: Pump — compile-time composition of participants.
//
//   std/pump:create(main)
//   | drained |> std/io:print.ln("all participants retired")
//
//   std/pump(main)
//   ! step |> tick-step()
//   ! live |> tick-live()
//   ! wait i |> tick-wait(i: i)
//
//   std/pump:run(main)
//   ! idle |> std/time:sleep-ms(ms: 2)
//
// A PARTICIPANT is anything that can answer up to three verbs:
//
//   step() -> i32    advance every live instance once; return how many made
//                    progress this pass. Required.
//   live() -> i64    how many instances are live; 0 = retired. Absent = the
//                    participant is immortal — it never drains the pump.
//   wait(i) -> interest    instance i's blocking interest — the RETURN TYPE
//                    is the vocabulary: `-> i32` fd, `-> i128` re-poll ns,
//                    `{ fd, wait_ns }` both; presence, never sentinels.
//                    Optional; unarmed participants add nothing to the wait.
//
// The join site `std/pump(name)` carries the verbs as `!` arms — the same
// reference form `std/store(name) ! field` uses for standing watches. Pass
// order is join order (document order). Each arm's body is compiled into a
// generated unit `__pump_<name>_{step,live,wait}_<idx>` — the verbs are
// ordinary calls, so a participant is any author-written unit: a module's
// singleton state, a hand-managed array, or a `! step` store (which exposes
// exactly these verbs as `<store>-step` / `<store>-live` / `<store>-wait`).
// The pump knows none of that — it calls names.
//
// `run` drives passes until Σ live() is 0 — a pump of only immortals IS the
// program's event loop. On an all-idle pass `run` fires `! idle` in the
// loop; unarmed it composes the wait itself — one `poll()` over every
// joined `wait` interest capped by the nearest `wait_ns`, else 1ms.
const std = @import("std");
const ast = @import("ast");
~part explain
~part messages
~part run-msgs
~part synth
~part wit
~part wait
~part run
const PH = struct {
    const codegen_utils = @import("codegen_utils");

    fn mkPath(alloc: std.mem.Allocator, module: []const u8, name: []const u8) ast.DottedPath {
        const segs = alloc.alloc([]const u8, 1) catch unreachable;
        segs[0] = alloc.dupe(u8, name) catch unreachable;
        return ast.DottedPath{ .module_qualifier = alloc.dupe(u8, module) catch unreachable, .segments = segs };
    }

    // store.kz's storeEventQualifier, restated — a module cannot call
    // another module's private fns. `main_module.` always on JS (the flat
    // tor namespace); `main_module.`/`koru_<path>.` on Zig.
    fn eventQual(alloc: std.mem.Allocator, home: []const u8, main: []const u8) []const u8 {
        if (std.mem.eql(u8, CompilerEnv.lang, "js")) return "main_module.";
        if (home.len == 0 or std.mem.eql(u8, home, main)) return "main_module.";
        const p = codegen_utils.buildKoruModulePath(alloc, home) catch unreachable;
        return std.fmt.allocPrint(alloc, "{s}.", .{p}) catch unreachable;
    }
    // Program-wide scan for an event_decl / proc_decl whose last path
    // segment is `name`. The pump coordinates entirely through generated
    // decl names — create emits a marker, joins emit units, run enumerates.
    fn findDecl(alloc: std.mem.Allocator, prog: *const ast.Program, name: []const u8) ?ast.DottedPath {
        _ = alloc;
        const W = struct {
            fn scan(its: []const ast.Item, w: []const u8) ?ast.DottedPath {
                for (its) |*pi| {
                    switch (pi.*) {
                        .event_decl => |*ed| {
                            if (ed.path.segments.len > 0 and std.mem.eql(u8, ed.path.segments[ed.path.segments.len - 1], w)) return ed.path;
                        },
                        .module_decl => |*md| {
                            if (scan(md.items, w)) |hit| return hit;
                        },
                        else => {},
                    }
                }
                return null;
            }
        };
        return W.scan(prog.items, name);
    }
    fn findEventDecl(prog: *const ast.Program, name: []const u8) ?*const ast.EventDecl {
        const W = struct {
            fn scan(its: []const ast.Item, w: []const u8) ?*const ast.EventDecl {
                for (its) |*pi| {
                    switch (pi.*) {
                        .event_decl => |*ed| {
                            if (ed.path.segments.len > 0 and std.mem.eql(u8, ed.path.segments[ed.path.segments.len - 1], w)) return ed;
                        },
                        .module_decl => |*md| {
                            if (scan(md.items, w)) |hit| return hit;
                        },
                        else => {},
                    }
                }
                return null;
            }
        };
        return W.scan(prog.items, name);
    }
    // A decl's `module_qualifier` is dot-joined (`lib.single`); an
    // invocation's qualifier keeps the import spelling (`lib/single`).
    // `null` on either side means "the file I'm in" — compare normalized.
    fn qualEql(a: ?[]const u8, b: ?[]const u8) bool {
        if (a == null or b == null) return a == null and b == null;
        const ae = a.?;
        const be = b.?;
        if (ae.len != be.len) return false;
        for (ae, be) |x, y| {
            if (x == y) continue;
            if ((x == '/' or x == '.') and (y == '/' or y == '.')) continue;
            return false;
        }
        return true;
    }
    // The decl behind an invocation path — last segment + qualifier.
    fn findPathDecl(prog: *const ast.Program, path: ast.DottedPath, home: []const u8) ?*const ast.EventDecl {
        if (path.segments.len == 0) return null;
        const want_name = path.segments[path.segments.len - 1];
        const want_qual = if (path.module_qualifier) |mq| mq else home;
        const W = struct {
            fn scan(its: []const ast.Item, wn: []const u8, wq: []const u8) ?*const ast.EventDecl {
                for (its) |*pi| {
                    switch (pi.*) {
                        .event_decl => |*ed| {
                            if (ed.path.segments.len > 0 and std.mem.eql(u8, ed.path.segments[ed.path.segments.len - 1], wn) and
                                qualEql(ed.path.module_qualifier, wq)) return ed;
                        },
                        .module_decl => |*md| {
                            if (scan(md.items, wn, wq)) |hit| return hit;
                        },
                        else => {},
                    }
                }
                return null;
            }
        };
        return W.scan(prog.items, want_name, want_qual);
    }
    // Decl markers are host_line comments — zero emission surface:
    // `__pump_decl_<name>` (create ran), `__pump_ran_<name>` (run emitted;
    // a join after it would never be driven). The convention itself is a
    // stamped claim on `create` — `- aspirational open-pump-marker-wire`.
    fn markerExists(prog: *const ast.Program, marker: []const u8) bool {
        const W = struct {
            fn scan(its: []const ast.Item, w: []const u8) bool {
                for (its) |*pi| {
                    switch (pi.*) {
                        .host_line => |*hl| {
                            if (std.mem.indexOf(u8, hl.content, w) != null) return true;
                        },
                        .module_decl => |*md| {
                            if (scan(md.items, w)) return true;
                        },
                        else => {},
                    }
                }
                return false;
            }
        };
        return W.scan(prog.items, marker);
    }
    // The store names live in the program as `__store_apply_<s>` decls — the
    // same scan store.kz's storeHome runs. A transplanted arm body may still
    // NAME a store (`tick.s`) — that is the author's text, rewritten here.
    fn storeHomes(alloc: std.mem.Allocator, prog: *const ast.Program) []const []const u8 {
        var names = std.ArrayList([]const u8).initCapacity(alloc, 4) catch unreachable;
        const W = struct {
            fn items(ns: *std.ArrayList([]const u8), al: std.mem.Allocator, its: []const ast.Item) void {
                for (its) |*pi| {
                    switch (pi.*) {
                        .event_decl => |*ed| {
                            if (ed.path.segments.len == 1 and std.mem.startsWith(u8, ed.path.segments[0], "__store_apply_")) {
                                ns.append(al, ed.path.segments[0]["__store_apply_".len..]) catch unreachable;
                            }
                        },
                        .module_decl => |*md| items(ns, al, md.items),
                        else => {},
                    }
                }
            }
        };
        W.items(&names, alloc, prog.items);
        return names.toOwnedSlice(alloc) catch unreachable;
    }
    fn storeRefsText(alloc: std.mem.Allocator, text: []const u8, names: []const []const u8) []const u8 {
        var t = text;
        for (names) |n| {
            t = oneStore(alloc, t, n);
        }
        return t;
    }
    fn oneStore(alloc: std.mem.Allocator, text: []const u8, name: []const u8) []const u8 {
        var out = std.ArrayList(u8).initCapacity(alloc, text.len + 32) catch unreachable;
        var i: usize = 0;
        while (i < text.len) {
            const at_boundary = ast.identBoundaryBefore(text, i);
            if (at_boundary and i + name.len < text.len and
                std.mem.startsWith(u8, text[i..], name) and text[i + name.len] == '.')
            {
                out.appendSlice(alloc, "__koru_store_") catch unreachable;
                out.appendSlice(alloc, name) catch unreachable;
                i += name.len;
            } else {
                out.append(alloc, text[i]) catch unreachable;
                i += 1;
            }
        }
        return out.toOwnedSlice(alloc) catch unreachable;
    }
    // The text-slot walk over a continuation tree — args' value /
    // expression_value / source_value and when-clause condition texts.
    fn rewriteCont(alloc: std.mem.Allocator, cont: *ast.Continuation, names: []const []const u8) void {
        if (cont.condition) |c| {
            const casted = @constCast(cont);
            casted.condition = storeRefsText(alloc, c, names);
        }
        if (cont.node) |*n| {
            const cn = @constCast(n);
            switch (cn.*) {
                .invocation => |*iv| {
                    for (@constCast(iv.args)) |*a| {
                        a.value = storeRefsText(alloc, a.value, names);
                        if (a.expression_value) |ev| {
                            @constCast(ev).text = storeRefsText(alloc, ev.text, names);
                        }
                        if (a.source_value) |sv| {
                            @constCast(sv).text = storeRefsText(alloc, sv.text, names);
                        }
                    }
                },
                .inline_code => |*ic| {
                    ic.* = storeRefsText(alloc, ic.*, names);
                },
                else => {},
            }
        }
        for (cont.continuations) |*cc| {
            rewriteCont(alloc, @constCast(cc), names);
        }
    }
    // The LAST invocation of an arm's `|>` chain is where `-> r` lands —
    // walk node + continuations, last invocation wins. null = the arm body
    // has no call at all. `lastInvocationMut` is the same walk for the write
    // path (setting the synthesized `-> __koru_r` binding).
    fn lastInvocation(cont: *const ast.Continuation) ?*const ast.Invocation {
        var hit: ?*const ast.Invocation = null;
        if (cont.node) |*n| {
            if (n.* == .invocation) hit = &n.invocation;
        }
        for (cont.continuations) |*cc| {
            // only the `|>` chain — a `!` arm hanging off the arm is an
            // effect continuation, not the value the verb returns
            if (std.mem.trim(u8, cc.branch, " ").len != 0) continue;
            if (cc.node) |*n| {
                if (n.* == .invocation) hit = &n.invocation;
            }
        }
        return hit;
    }
    fn lastInvocationMut(cont: *ast.Continuation) ?*ast.Invocation {
        var hit: ?*ast.Invocation = null;
        if (cont.node) |*n| {
            if (n.* == .invocation) hit = &n.invocation;
        }
        for (cont.continuations) |*cc| {
            if (std.mem.trim(u8, cc.branch, " ").len != 0) continue;
            const c = @constCast(cc);
            if (c.node) |*n| {
                if (n.* == .invocation) hit = &n.invocation;
            }
        }
        return hit;
    }
    // The arm body's callee — the last invocation's path — looked up so the
    // verb's return contract can be checked before emission.
    fn calleeDecl(prog: *const ast.Program, cont: *const ast.Continuation, home: []const u8) ?*const ast.EventDecl {
        const li = lastInvocation(cont) orelse return null;
        return findPathDecl(prog, li.path, home);
    }
    fn markerItem(alloc: std.mem.Allocator, flow: *const ast.Flow, text: []const u8) ast.Item {
        return ast.Item{ .host_line = ast.HostLine{
            .content = std.fmt.allocPrint(alloc, "// {s}", .{text}) catch unreachable,
            .location = flow.location,
            .module = alloc.dupe(u8, flow.module) catch unreachable,
        } };
    }
    fn markerDecl(alloc: std.mem.Allocator, comptime suffix: []const u8, name: []const u8) []const u8 {
        return std.fmt.allocPrint(alloc, "__pump_" ++ suffix ++ "_{s}", .{name}) catch unreachable;
    }
};

// An arm compiled into a callable unit: tor decl + impl. The arm's `|>`
// chain is cloned, its last invocation bound `-> __koru_r`, and a bare-return
// continuation hands the value up. Returns the refusal SiteResult on
// malformed bodies so callers can return it directly.
fn emitVerbUnit(
    allocator: std.mem.Allocator,
    appended: *std.ArrayList(ast.Item),
    program: *const ast.Program,
    flow: *const ast.Flow,
    unit_name: []const u8,
    arm: *const ast.Continuation,
    input_fields: []ast.Field,
    return_type: []const u8,
    bind_name: []const u8,
    return_expr: []const u8,
) void {
    const ast_functional = @import("ast_functional");
    const host_is_js = std.mem.eql(u8, CompilerEnv.lang, "js");
    const retain_ann = blk_ra: {
        const anns = allocator.alloc([]const u8, 1) catch unreachable;
        anns[0] = allocator.dupe(u8, "retain") catch unreachable;
        break :blk_ra anns;
    };
    appended.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
        .path = PH.mkPath(allocator, ast_functional.moduleHome(program, flow) orelse flow.module, unit_name),
        .input = ast.Shape{ .fields = input_fields },
        .branches = &[_]ast.Branch{},
        .return_type = allocator.dupe(u8, return_type) catch unreachable,
        .is_public = false,
        .is_implicit_flow = false,
        .annotations = retain_ann,
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } }) catch unreachable;
    var aclone = ast_functional.cloneContinuation(allocator, arm) catch unreachable;
    PH.rewriteCont(allocator, &aclone, PH.storeHomes(allocator, program));
    const anode = aclone.node.?;
    if (anode == .inline_code) {
        appended.append(allocator, ast.Item{ .proc_decl = ast.ProcDecl{
            .path = PH.mkPath(allocator, ast_functional.moduleHome(program, flow) orelse flow.module, unit_name),
            .body = ast.Source{ .text = anode.inline_code, .location = flow.location, .scope = .{ .bindings = &[_]ast.ScopeBinding{} }, .phantom_type = null },
            .annotations = &[_][]const u8{},
            .target = allocator.dupe(u8, if (host_is_js) "js" else "zig") catch unreachable,
            .location = flow.location,
            .module = allocator.dupe(u8, flow.module) catch unreachable,
        } }) catch unreachable;
        return;
    }
    if (PH.lastInvocationMut(&aclone)) |li| {
        li.return_binding = allocator.dupe(u8, bind_name) catch unreachable;
    }
    var conts = std.ArrayList(ast.Continuation).initCapacity(allocator, aclone.continuations.len + 1) catch unreachable;
    for (aclone.continuations) |*c| conts.append(allocator, c.*) catch unreachable;
    conts.append(allocator, ast.Continuation{
        .branch = allocator.dupe(u8, "") catch unreachable,
        .binding = null,
        .kind = .terminal,
        .condition = null,
        .node = ast.Node{ .branch_constructor = ast.BranchConstructor{
            .branch_name = allocator.dupe(u8, "") catch unreachable,
            .fields = &[_]ast.Field{},
            .plain_value = allocator.dupe(u8, return_expr) catch unreachable,
            .is_bare_return = true,
        } },
        .indent = 0,
        .continuations = &[_]ast.Continuation{},
    }) catch unreachable;
    // NOTE: `aclone.node` re-read AFTER the mutation — an earlier extraction
    // would hand rootSite the pre-binding copy.
    const rnode = aclone.node.?;
    appended.append(allocator, ast.Item{ .flow = ast.Flow{
        .body = ast.rootSite(rnode.invocation, conts.items, flow.location),
        .pre_label = null,
        .impl_of = PH.mkPath(allocator, ast_functional.moduleHome(program, flow) orelse flow.module, unit_name),
        .super_shape = null,
        .inline_body = rnode.invocation.inline_body,
        .preamble_code = rnode.invocation.preamble_code,
        .is_pure = false,
        .is_transitively_pure = false,
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } }) catch unreachable;
}

fn siteFlow(item: *const ast.Item, who: []const u8) *const ast.Flow {
    if (item.* != .flow) @panic(who);
    return &item.flow;
}

fn siteName(invocation: *const ast.Invocation) []const u8 {
    var name: []const u8 = "";
    for (invocation.args) |a| {
        if (a.source_value != null) continue;
        if (a.value.len > 0 and name.len == 0) name = a.value;
    }
    if (name.len >= 2 and name[0] == '"') name = name[1 .. name.len - 1];
    return name;
}

// ----------------------------------------------------------------------------
// PUMP.CREATE — declare the pump.
//
//   std/pump:create(main)
//   | drained |> ...
//
// Emits the `__pump_decl_<name>` marker and the drained unit. Declarations
// precede joins, joins precede run — transforms run in source order.

~[
- keyword|comptime|transform
- aspirational open-pump-marker-wire
  Comment-wire markers restated per participant transform; the typed
  program-item migration is resolved — concepts/frag-comment-markers-are-the-inter-transform-wire.
]pub tor create {
    expr: Expression,
    invocation: *const Invocation,
    item: *const std/compiler:Item,
    program: *const std/compiler:Program,
    reporter: *std/compiler:ErrorReporter,
    allocator: std.mem.Allocator
} -> SiteResult

~[transform]proc create|zig {
    const ast_functional = @import("ast_functional");
    const flow = siteFlow(item, "pump:create transform: containing item is not a flow - walker dispatch contract broken");
    const host_is_js = std.mem.eql(u8, CompilerEnv.lang, "js");
    const proc_target = if (host_is_js) "js" else "zig";

    const pump_name = siteName(invocation);
    if (pump_name.len == 0) {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, PM.create_needs_name, .{}) } };
    }
    if (PH.markerExists(program, PH.markerDecl(allocator, "decl", pump_name))) {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, PM.create_dup, .{ pump_name, pump_name }) } };
    }

    // `| drained` — the pump's lifecycle arm, fired by run when every
    // participant's `live` answers 0.
    var drained_arm: ?*const ast.Continuation = null;
    for (flow.body.continuations) |*c| {
        const cb = std.mem.trim(u8, c.branch, " ");
        if (cb.len == 0) continue;
        if (c.kind == .effect) {
            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, PM.create_effect_arm, .{ pump_name, cb, pump_name }) } };
        }
        if (!std.mem.eql(u8, cb, "drained")) {
            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, PM.create_unknown_arm, .{ pump_name, cb }) } };
        }
        if (drained_arm != null) {
            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, PM.create_drained_once, .{pump_name}) } };
        }
        if (c.node == null) {
            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, PM.create_drained_needs_body, .{pump_name}) } };
        }
        drained_arm = c;
    }

    var appended_items = std.ArrayList(ast.Item).initCapacity(allocator, 8) catch unreachable;
    appended_items.append(allocator, PH.markerItem(allocator, flow, PH.markerDecl(allocator, "decl", pump_name))) catch unreachable;

    const drained_name = PH.markerDecl(allocator, "drained", pump_name);
    const retain_ann = blk_ra: {
        const anns = allocator.alloc([]const u8, 1) catch unreachable;
        anns[0] = allocator.dupe(u8, "retain") catch unreachable;
        break :blk_ra anns;
    };
    if (drained_arm) |da| {
        appended_items.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
            .path = PH.mkPath(allocator, ast_functional.moduleHome(program, flow) orelse flow.module, drained_name),
            .input = ast.Shape{ .fields = &[_]ast.Field{} },
            .branches = &[_]ast.Branch{},
            .is_public = false,
            .is_implicit_flow = false,
            .annotations = retain_ann,
            .location = flow.location,
            .module = allocator.dupe(u8, flow.module) catch unreachable,
        } }) catch unreachable;
        var dclone = ast_functional.cloneContinuation(allocator, da) catch unreachable;
        PH.rewriteCont(allocator, &dclone, PH.storeHomes(allocator, program));
        const dnode = dclone.node.?;
        if (dnode == .inline_code) {
            appended_items.append(allocator, ast.Item{ .proc_decl = ast.ProcDecl{
                .path = PH.mkPath(allocator, ast_functional.moduleHome(program, flow) orelse flow.module, drained_name),
                .body = ast.Source{ .text = dnode.inline_code, .location = flow.location, .scope = .{ .bindings = &[_]ast.ScopeBinding{} }, .phantom_type = null },
                .annotations = &[_][]const u8{},
                .target = allocator.dupe(u8, proc_target) catch unreachable,
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;
        } else {
            appended_items.append(allocator, ast.Item{ .flow = ast.Flow{
                .body = ast.rootSite(dnode.invocation, dclone.continuations, flow.location),
                .pre_label = null,
                .impl_of = PH.mkPath(allocator, ast_functional.moduleHome(program, flow) orelse flow.module, drained_name),
                .super_shape = null,
                .inline_body = dnode.invocation.inline_body,
                .preamble_code = dnode.invocation.preamble_code,
                .is_pure = false,
                .is_transitively_pure = false,
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;
        }
    }

    const pconsumed = std.fmt.allocPrint(allocator, "// std/pump: pump '{s}' created", .{pump_name}) catch unreachable;
    return .{ .transformed = .{ .replacement = ast.Item{ .host_line = ast.HostLine{
        .content = pconsumed,
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } }, .appended = appended_items.toOwnedSlice(allocator) catch unreachable } };
}

// ----------------------------------------------------------------------------
// PUMP.DEFAULT — the bare `std/pump(name)` reference form: a participant JOIN.
//
//   std/pump(main)
//   ! step |> <call>          — required, `-> i32` progress count
//   ! live |> <call>          — optional, `-> i64` live-instance count
//   ! wait i |> <call(i)>     — optional, interest by return type:
//                               `i32` (fd) / `i128` (re-poll ns) / `{ fd, wait_ns }`
//
// Each arm compiles into `__pump_<name>_{step,live,wait}_<idx>`; run
// enumerates them. The verbs are ordinary calls — the pump never learns what
// implements them.
// ----------------------------------------------------------------------------

~[keyword|comptime|transform]pub tor default {
    expr: Expression,
    invocation: *const Invocation,
    item: *const std/compiler:Item,
    program: *const std/compiler:Program,
    reporter: *std/compiler:ErrorReporter,
    allocator: std.mem.Allocator
} -> SiteResult

~[transform]proc default|zig {
    const flow = siteFlow(item, "pump:default transform: containing item is not a flow - walker dispatch contract broken");

    const pump_name = siteName(invocation);
    if (pump_name.len == 0) {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, PM.join_needs_name, .{}) } };
    }
    if (!PH.markerExists(program, PH.markerDecl(allocator, "decl", pump_name))) {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, PM.join_no_pump, .{ pump_name, pump_name, pump_name }) } };
    }
    if (PH.markerExists(program, PH.markerDecl(allocator, "ran", pump_name))) {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, PM.join_after_run, .{ pump_name, pump_name }) } };
    }

    // Collect the verb arms. Only `!` continuations parse on a join; each of
    // step/live/wait once.
    var step_arm: ?*const ast.Continuation = null;
    var live_arm: ?*const ast.Continuation = null;
    var wait_arm: ?*const ast.Continuation = null;
    for (flow.body.continuations) |*c| {
        const cb = std.mem.trim(u8, c.branch, " ");
        if (cb.len == 0) continue;
        if (c.kind != .effect) {
            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, PM.join_terminal_arm, .{ pump_name, cb }) } };
        }
        if (std.mem.eql(u8, cb, "step")) {
            if (step_arm != null) return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, PM.join_one_step, .{pump_name}) } };
            step_arm = c;
        } else if (std.mem.eql(u8, cb, "live")) {
            if (live_arm != null) return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, PM.join_one_live, .{pump_name}) } };
            live_arm = c;
        } else if (std.mem.eql(u8, cb, "wait")) {
            if (wait_arm != null) return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, PM.join_one_wait, .{pump_name}) } };
            wait_arm = c;
        } else {
            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, PM.join_unknown_verb, .{ pump_name, cb }) } };
        }
    }
    if (step_arm == null) {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, PM.join_needs_step, .{pump_name}) } };
    }
    if (wait_arm != null and live_arm == null) {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, PM.join_wait_needs_live, .{pump_name}) } };
    }

    // Contract checks — the verb bodies must be calls returning the right
    // shape, and the callee must already be declared (joins follow the
    // participant's own declaration in document order).
    if (step_arm.?.binding != null) {
        return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, PM.join_step_binds_nothing, .{pump_name}) } };
    }
    const Verbs = struct { arm: ?*const ast.Continuation, want: []const u8, verb: []const u8 };
    const checks = [_]Verbs{
        .{ .arm = step_arm, .want = "i32", .verb = "step" },
        .{ .arm = live_arm, .want = "i64", .verb = "live" },
        .{ .arm = wait_arm, .want = "the interest contract: `i32` (fd), `i128` (re-poll ns), or `{ fd, wait_ns }`", .verb = "wait" },
    };
    var wait_interest: PWait.Interest = .{};
    for (checks) |ck| {
        const arm = ck.arm orelse continue;
        const cd = PH.calleeDecl(program, arm, flow.module) orelse {
            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, PM.join_verb_needs_tor, .{ pump_name, ck.verb }) } };
        };
        const rt = cd.return_type orelse {
            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, PM.join_verb_no_return, .{ pump_name, ck.verb, ck.want }) } };
        };
        if (std.mem.eql(u8, ck.verb, "wait")) {
            wait_interest = PWait.classify(rt) orelse
                return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, PM.join_wait_no_interest, .{ pump_name, rt }) } };
        } else if (std.mem.indexOf(u8, rt, ck.want) == null) {
            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, PM.join_verb_wrong_return, .{ pump_name, ck.verb, rt, ck.want }) } };
        }
    }

    // The join index — count existing step units for this pump.
    var join_idx: usize = 0;
    while (PH.findDecl(allocator, program, std.fmt.allocPrint(allocator, "__pump_{s}_step_{d}", .{ pump_name, join_idx }) catch unreachable) != null) {
        join_idx += 1;
    }

    var appended_items = std.ArrayList(ast.Item).initCapacity(allocator, 8) catch unreachable;
    emitVerbUnit(allocator, &appended_items, program, flow, std.fmt.allocPrint(allocator, "__pump_{s}_step_{d}", .{ pump_name, join_idx }) catch unreachable, step_arm.?, &[_]ast.Field{}, "i32", "__koru_r", "__koru_r");
    if (live_arm) |la| {
        emitVerbUnit(allocator, &appended_items, program, flow, std.fmt.allocPrint(allocator, "__pump_{s}_live_{d}", .{ pump_name, join_idx }) catch unreachable, la, &[_]ast.Field{}, "i64", "__koru_r", "__koru_r");
    }
    if (wait_arm) |wa| {
        const wbind = wa.binding orelse {
            return .{ .transformed = .{ .replacement = ast.refusal(allocator, reporter, .KORU161, flow.location, flow.module, PM.join_wait_binds_index, .{pump_name}) } };
        };
        PWait.emitWait(allocator, &appended_items, program, flow, pump_name, join_idx, wa, wbind, wait_interest);
    }

    const pconsumed = std.fmt.allocPrint(allocator, "// std/pump: '{s}' joins pump '{s}' (participant {d})", .{ pump_name, pump_name, join_idx }) catch unreachable;
    return .{ .transformed = .{ .replacement = ast.Item{ .host_line = ast.HostLine{
        .content = pconsumed,
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } }, .appended = appended_items.toOwnedSlice(allocator) catch unreachable } };
}
