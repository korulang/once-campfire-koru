    acct_join_len = j;
    acct_restrict_v = restrict;
    const v = @min(ver.len, acct_ver_buf.len);
    @memcpy(acct_ver_buf[0..v], ver[0..v]);
    acct_ver_len = v;
}

~proc acct-name|zig {
