}

// The account-name form + creation-restriction switch. The switch posts a
// put with the TOGGLED value, mirroring the reference hidden field.
threadlocal var ablock_buf: [6144]u8 = undefined;

~proc acct-admin-block|zig {
    if (role != 1) return "";
    var n: usize = 0;
    appendInto(&ablock_buf, &n, "<form class=\"flex flex-column gap\" action=\"/account\" accept-charset=\"UTF-8\" method=\"post\" data-controller=\"form\"><input type=\"hidden\" name=\"_method\" value=\"patch\" />");
    appendInto(&ablock_buf, &n, csrfInputZ(&csrf_in_buf));
    appendInto(&ablock_buf, &n, "<div class=\"flex align-center gap\"><label class=\"flex align-center gap flex-item-grow\"><input type=\"text\" name=\"account[name]\" id=\"account_name\" value=\"");
    escInto(&ablock_buf, &n, name);
    appendInto(&ablock_buf, &n, "\" autocomplete=\"off\" placeholder=\"Name this account\" autofocus=\"autofocus\" data-action=\"keydown.enter-&gt;form#submit\" class=\"input txt-large\" /></label><button class=\"btn btn--reversed center\" type=\"submit\"><img aria-hidden=\"true\" src=\"/assets/check-7897ff7e.svg\" width=\"20\" height=\"20\" /><span class=\"for-screen-reader\">Save changes</span></button></div></form><div class=\"margin-block-start pad-block pad-inline-double fill-shade border-radius\"><form class=\"flex align-center gap center\" action=\"/account\" accept-charset=\"UTF-8\" method=\"post\" data-controller=\"form\"><input type=\"hidden\" name=\"_method\" value=\"put\" />");
    appendInto(&ablock_buf, &n, csrfInputZ(&csrf_in_buf));
    appendInto(&ablock_buf, &n, "<div class=\"flex-item-grow flex align-center gap txt-align-start\"><img aria-hidden=\"true\" class=\"colorize--black\" src=\"/assets/crown-00d190cb.svg\" width=\"18\" height=\"18\" /> Must be admin to create new rooms</div><input type=\"hidden\" name=\"account[settings_attributes][restrict_room_creation_to_administrators]\" value=\"");
    appendInto(&ablock_buf, &n, if (restrict == 0) "true" else "false");
    appendInto(&ablock_buf, &n, "\" /><label class=\"switch\"><input type=\"checkbox\" class=\"switch__input\" ");
    if (restrict != 0) appendInto(&ablock_buf, &n, "checked=\"checked\" ");
    appendInto(&ablock_buf, &n, "data-action=\"change-&gt;form#submit\" /><span class=\"switch__btn round\"></span><span class=\"for-screen-reader\">Must be admin to create new rooms</span></label></form></div>");
    return ablock_buf[0..n];
}

