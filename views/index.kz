}

threadlocal var regen_buf: [1024]u8 = undefined;

~proc acct-regen|zig {
    if (role != 1) return "";
    var n: usize = 0;
    appendInto(&regen_buf, &n, "<form class=\"button_to\" method=\"post\" action=\"/account/join_code\">");
    appendInto(&regen_buf, &n, csrfInputZ(&csrf_in_buf));
    appendInto(&regen_buf, &n, "<button class=\"btn btn--regenerate\" type=\"submit\"><img aria-hidden=\"true\" class=\"colorize--black\" src=\"/assets/refresh-249f0509.svg\" width=\"20\" height=\"20\" /><span class=\"for-screen-reader\">Regenerate join link</span></button></form>");
    return regen_buf[0..n];
}

// ── Direct-room user_ids plumbing ───────────────────────────────────────────
// form-ids yields "a,b"; the current user joins the set — appended only when
// absent (the select may already carry them). uids-count answers the member
// total for the find-for exact-match query.
threadlocal var uj_buf: [512]u8 = undefined;

// Emits a JSON array ("[3,1]") so call sites can splice it through a bound
// parameter: `u.id IN (SELECT value FROM json_each({{allids}}))`. A bare
// "3,1" would bind as a single string literal and match nothing.
~proc uids-join|zig {
    var n: usize = 0;
    var have = false;
    var want_buf: [24]u8 = undefined;
    const want = std.fmt.bufPrint(&want_buf, "{d}", .{uid}) catch return "";
    uj_buf[n] = '[';
    n += 1;
    var it = std.mem.splitScalar(u8, ids, ',');
    while (it.next()) |part| {
        if (part.len == 0) continue;
        if (std.mem.eql(u8, part, want)) have = true;
        if (n > 1) {
            uj_buf[n] = ',';
            n += 1;
        }
        appendInto(&uj_buf, &n, part);
    }
    if (!have) {
        if (n > 1) {
            uj_buf[n] = ',';
            n += 1;
        }
        appendInto(&uj_buf, &n, want);
    }
    uj_buf[n] = ']';
    n += 1;
    return uj_buf[0..n];
}

~proc uids-count|zig {
    if (ids.len == 0) return 0;
    var c: i64 = 1;
    for (ids) |ch| {
        if (ch == ',') c += 1;
    }
    return c;
}

// dom_id(room, :list) — the sidebar anchor id that broadcast_replace_to
// targets on rename: "list_rooms_open_<id>" / "list_rooms_closed_<id>" /
