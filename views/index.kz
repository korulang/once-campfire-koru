}

// ── Tokens + account-page blocks ────────────────────────────────────────────
// SecureRandom.alphanumeric(12) — [0-9A-Za-z] — used for bot_token and the
// join code's 12 characters (grouped 4-4-4 with dashes, the stored form).
const ALNUM = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";

fn randAlnum(out: []u8) void {
    var bytes: [64]u8 = undefined;
    std.crypto.random.bytes(bytes[0..out.len]);
    for (out, 0..) |*c, i| c.* = ALNUM[bytes[i] % ALNUM.len];
}

threadlocal var jcode_buf: [24]u8 = undefined;

~proc join-code|zig {
    var raw: [12]u8 = undefined;
    randAlnum(&raw);
    var n: usize = 0;
    for (raw, 0..) |c, i| {
        if (i == 4 or i == 8) {
            jcode_buf[n] = '-';
            n += 1;
        }
        jcode_buf[n] = c;
        n += 1;
    }
    return jcode_buf[0..n];
}

threadlocal var btok_buf: [16]u8 = undefined;

~proc bot-token|zig {
    var raw: [12]u8 = undefined;
    randAlnum(&raw);
    @memcpy(btok_buf[0..12], &raw);
    return btok_buf[0..12];
}

// accounts/edit nav — administrators get the bots and custom-styles links;
// members get nothing (the smoke checks "Set up chat bots" is absent).
~proc acct-nav-admin|zig {
