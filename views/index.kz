~proc head-build|zig {
    var n: usize = 0;
    appendInto(&head_buf, &n, "<!DOCTYPE html>");
    appendInto(&head_buf, &n, head_a);
    escInto(&head_buf, &n, title);
    appendInto(&head_buf, &n, head_b);
    appendInto(&head_buf, &n, metas);
    appendInto(&head_buf, &n, head_c);
    // vapid_public_key_tag — VAPID_PUBLIC_KEY from the environment like the
    // reference; absent the env the meta keeps its empty content rather
    // than inventing a key.
    if (std.posix.getenv("VAPID_PUBLIC_KEY")) |vpk| {
        appendInto(&head_buf, &n, "    <meta name=\"vapid-public-key\" content=\"");
        escInto(&head_buf, &n, vpk);
        appendInto(&head_buf, &n, "\">\n");
    } else {
        appendInto(&head_buf, &n, "    <meta name=\"vapid-public-key\">\n");
    }
    appendInto(&head_buf, &n, head_c2);
    appendInto(&head_buf, &n, logo);
    appendInto(&head_buf, &n, head_d);
    appendInto(&head_buf, &n, logo);
    appendInto(&head_buf, &n, head_e);
    appendInto(&head_buf, &n, styles);
    appendInto(&head_buf, &n, head_f);
    return head_buf[0..n];
}

// "New Chat Room" nav button — admins always, members only when the account
// doesn't restrict creation (accounts.settings.restrict_room_creation_to_administrators).
threadlocal var nrb_buf: [1024]u8 = undefined;

~proc new-room-btn|zig {
    if (role != 1 and restrict != 0) return "";
    const s = "<a href=\"/rooms/opens/new\" class=\"rooms__new-btn btn room align-center gap txt-reversed\" aria-label=\"New Chat Room\"><img aria-hidden=\"true\" src=\"/assets/add-f232d8a6.svg\" width=\"20\" height=\"20\" style=\"view-transition-name: new-room\" /></a>";
    const n = @min(s.len, nrb_buf.len);
    @memcpy(nrb_buf[0..n], s[0..n]);
    return nrb_buf[0..n];
}

~proc profile-render|zig {
    return ProfilePage_render_event.handler(.{ .uid = uid, .name = name, .email = email, .bio = bio, .turl = turl, .qrpath = qrpath, .memberships = memberships, .csrf = csrfTok() });
}
~proc account-render|zig {
    return AccountPage_render_event.handler(.{ .navadmin = navadmin, .admin = admin, .member = member, .inviteurl = inviteurl, .qrpath = qrpath, .regen = regen, .users = users });
}
~proc roomform-render|zig {
    return RoomFormPage_render_event.handler(.{ .action = action, .method = method, .name = name, .users = users, .csrf = csrfTok() });
}
~proc bots-render|zig {
    return BotsPage_render_event.handler(.{ .bots = bots });
}
~proc botform-render|zig {
    return BotFormPage_render_event.handler(.{ .action = action, .method = method, .name = name, .webhook = webhook, .csrf = csrfTok() });
}
~proc styles-render|zig {
    return StylesPage_render_event.handler(.{ .css = css, .csrf = csrfTok() });
}
// The auto-submit form's action — session_transfer_path, the page's own URL.
threadlocal var tact_buf: [1024]u8 = undefined;

~proc transfer-action|zig {
    return std.fmt.bufPrint(&tact_buf, "/session/transfers/{s}", .{sid}) catch "";
}

~proc transfer-render|zig {
    return TransferPage_render_event.handler(.{ .action = action, .csrf = csrfTok() });
}
~proc join-render|zig {
    return JoinPage_render_event.handler(.{ .action = action, .acctname = acctname, .csrf = csrfTok() });
}
~proc directs-render|zig {
    return DirectsPage_render_event.handler(.{ .csrf = csrfTok() });
}

// ── sessions/new ────────────────────────────────────────────────────────────
// The reference's sessions/new.html body verbatim — language menus, panel,
// support mailto, version badge — with the per-request slots spliced: the
// masked token (first form child, as form_with emits), the absolute form
// action Rails builds from the request host, the account name in the legend,
// the administrator mailto, the logo version, and APP_VERSION's badge.
threadlocal var signin_buf: [16384]u8 = undefined;

~proc signin-body|zig {
    var n: usize = 0;
    const B = &signin_buf;
    appendInto(B, &n, "<body class=\"\" data-controller=\"local-time lightbox\">\n    <a href=\"#main-content\" class=\"skip-navigation btn\">Skip to main content</a>\n\n    <nav id=\"nav\">\n      \n    </nav>\n\n\n    <main id=\"main-content\">\n      \n<section class=\"txt-align-center\">\n  <div class=\"panel \">\n    <figure class=\"account-logo avatar center margin-block-end txt-xx-large\"><img alt=\"Account logo\" src=\"/account/logo?v=");
    appendInto(B, &n, logo);
    appendInto(B, &n, "\" width=\"300\" height=\"300\" /></figure>\n\n    <form class=\"flex flex-column gap\" action=\"http://");
    appendInto(B, &n, host);
    appendInto(B, &n, "/session\" accept-charset=\"UTF-8\" method=\"post\">");
    if (csrf_len > 0) appendInto(B, &n, csrfInputZ(&csrf_in_buf));
    appendInto(B, &n, "\n      <fieldset class=\"flex flex-column gap center-block upad\">\n        <legend class=\"txt-large txt-align-center\"><strong>");
    escInto(B, &n, acct);
    appendInto(B, &n, "</strong></legend>\n\n        <div class=\"flex align-center gap\">\n          <details class=\"position-relative\" data-controller=\"popup\" data-action=\"keydown.esc-&gt;popup#close toggle-&gt;popup#toggle click@document-&gt;popup#closeOnClickOutside\" data-popup-orientation-top-class=\"popup-orientation-top\"><summary class=\"btn\" tabindex=\"-1\"><img aria-hidden=\"true\" class=\"color-icon\" src=\"/assets/globe-8c54d23b.svg\" width=\"20\" height=\"20\" /><span class=\"for-screen-reader\">Translate</span></summary><div class=\"language-list-menu shadow\" data-popup-target=\"menu\"><dl class=\"language-list\"><dt>🇺🇸</dt><dd class=\"margin-none\">Enter your email address</dd><dt>🇪🇸</dt><dd class=\"margin-none\">Introduce tu correo electrónico</dd><dt>🇫🇷</dt><dd class=\"margin-none\">Entrez votre adresse courriel</dd><dt>🇮🇳</dt><dd class=\"margin-none\">अपना ईमेल पता दर्ज करें</dd><dt>🇩🇪</dt><dd class=\"margin-none\">Geben Sie Ihre E-Mail-Adresse ein</dd><dt>🇧🇷</dt><dd class=\"margin-none\">Insira seu endereço de email</dd><dt>🇯🇵</dt><dd class=\"margin-none\">メールアドレスを入力してください</dd></dl></div></details>\n          <label class=\"flex align-center gap input input--actor txt-large\">\n            <input required=\"required\" class=\"input\" autofocus=\"autofocus\" autocomplete=\"username\" placeholder=\"Enter your email address\" type=\"email\" name=\"email_address\" id=\"email_address\" />\n            <img aria-hidden=\"true\" class=\"colorize--black\" src=\"/assets/email-6c595bc5.svg\" width=\"24\" height=\"24\" />\n          </label>\n        </div>\n\n        <div class=\"flex align-center gap\">\n          <details class=\"position-relative\" data-controller=\"popup\" data-action=\"keydown.esc-&gt;popup#close toggle-&gt;popup#toggle click@document-&gt;popup#closeOnClickOutside\" data-popup-orientation-top-class=\"popup-orientation-top\"><summary class=\"btn\" tabindex=\"-1\"><img aria-hidden=\"true\" class=\"color-icon\" src=\"/assets/globe-8c54d23b.svg\" width=\"20\" height=\"20\" /><span class=\"for-screen-reader\">Translate</span></summary><div class=\"language-list-menu shadow\" data-popup-target=\"menu\"><dl class=\"language-list\"><dt>🇺🇸</dt><dd class=\"margin-none\">Enter your password</dd><dt>🇪🇸</dt><dd class=\"margin-none\">Introduce tu contraseña</dd><dt>🇫🇷</dt><dd class=\"margin-none\">Saisissez votre mot de passe</dd><dt>🇮🇳</dt><dd class=\"margin-none\">अपना पासवर्ड दर्ज करें</dd><dt>🇩🇪</dt><dd class=\"margin-none\">Geben Sie Ihr Passwort ein</dd><dt>🇧🇷</dt><dd class=\"margin-none\">Insira sua senha</dd><dt>🇯🇵</dt><dd class=\"margin-none\">パスワードを入力してください</dd></dl></div></details>\n          <label class=\"flex align-center gap input input--actor txt-large\">\n            <input required=\"required\" class=\"input\" autocomplete=\"current-password\" placeholder=\"Enter your password\" maxlength=\"72\" size=\"72\" type=\"password\" name=\"password\" id=\"password\" />\n            <img aria-hidden=\"true\" class=\"colorize--black\" src=\"/assets/password-0896da4e.svg\" width=\"24\" height=\"24\" />\n          </label>\n        </div>\n\n        <button name=\"log_in\" type=\"submit\" class=\"btn btn--reversed center txt-large\">\n          <img aria-hidden=\"true\" src=\"/assets/arrow-right-8f3eb40d.svg\" />\n          <span class=\"for-screen-reader\">Go</span>\n</button>      </fieldset>\n</form>  </div>\n\n    <div class=\"txt-align-center margin-block-double full-width\">\n    <a class=\"btn center\" title=\"Email ");
    escInto(B, &n, mailname);
    appendInto(B, &n, "\" href=\"mailto:&quot;");
    escInto(B, &n, mailname);
    appendInto(B, &n, "&quot; &lt;");
    escInto(B, &n, mailemail);
    appendInto(B, &n, "&gt;\">\n      <img aria-hidden=\"true\" src=\"/assets/lifebuoy-f31f26aa.svg\" />\n      <span>");
    escInto(B, &n, mailemail);
    appendInto(B, &n, "</span>\n</a>\n    <div class=\"txt-align-center center margin-block txt-subtle\">Campfire&trade; version <span class=\"version-badge\">");
    escInto(B, &n, std.posix.getenv("APP_VERSION") orelse "");
    appendInto(B, &n, "</span></div>\n  </div>\n\n</section>\n\n\n      <footer id=\"footer\">\n        \n      </footer>\n    </main>\n\n    <aside id=\"sidebar\" data-controller=\"toggle-class\" data-toggle-class-toggle-class=\"open\">\n      \n    </aside>\n\n    <dialog class=\"lightbox\" aria-label=\"Image Viewer (Press escape to close)\" data-lightbox-target=\"dialog\" data-action=\"close-&gt;lightbox#reset\">\n  <img src=\"\" class=\"lightbox__image\" data-lightbox-target=\"zoomedImage\" />\n\n  <form method=\"dialog\" class=\"lightbox__btn\">\n    <button class=\"btn\">\n      <img aria-hidden=\"true\" src=\"/assets/remove-0e7a045d.svg\" />\n      <span class=\"for-screen-reader\">Close image viewer</span>\n    </button>\n  </form>\n\n  <a href=\"\" class=\"lightbox__btn--download btn hide-in-ios-pwa\" data-lightbox-target=\"download\">\n    <img aria-hidden=\"true\" src=\"/assets/download-04029899.svg\" />\n    <span class=\"for-screen-reader\">Download file</span>\n  </a>\n\n  <button class=\"lightbox__btn--share btn\"\n      data-controller=\"web-share\"\n      data-action=\"web-share#share\"\n      data-web-share-files-value=\"\"\n      data-lightbox-target=\"share\">\n    <img aria-hidden=\"true\" src=\"/assets/share-bf28da4f.svg\" />\n    <span class=\"for-screen-reader\">Share file</span>\n  </button>\n</dialog>\n\n\n    <a href=\"https://once.com\" id=\"app-logo\" target=\"_blank\" aria-label=\"Once software from 37signals home page\">\n      <img alt=\"Campfire logo\" width=\"256\" height=\"216\" src=\"/assets/campfire-icon-3d9986c5.png\" />\n    </a>\n  </body>\n</html>\n");
    return signin_buf[0..n];
}
