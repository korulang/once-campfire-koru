// views/index.kz — the zig half of the views module: request-scoped stashes
// (room, current user, boost arena), timestamp shaping, path keys. Markup
// lives in index.k (components); this file is arithmetic and state only.

const std = @import("std");

// ── Room stash — the room row fires once, the shell needs its values ────────
// Same threadlocal-cell pattern as session/: a handler runs to completion on
// one worker thread, so these cells are request-scoped.
threadlocal var room_name_buf: [256]u8 = undefined;
threadlocal var room_name_len: usize = 0;
threadlocal var room_type_buf: [64]u8 = undefined;
threadlocal var room_type_len: usize = 0;
threadlocal var room_seen: bool = false;

~proc stash-room|zig {
    const n = @min(name.len, room_name_buf.len);
    @memcpy(room_name_buf[0..n], name[0..n]);
    room_name_len = n;
    const t = @min(rtype.len, room_type_buf.len);
    @memcpy(room_type_buf[0..t], rtype[0..t]);
    room_type_len = t;
    room_seen = true;
}

// ── User stash — the membership join also yields the current user ───────────
threadlocal var user_id_v: i64 = 0;
threadlocal var user_role_v: i64 = 0;
threadlocal var user_name_buf: [256]u8 = undefined;
threadlocal var user_name_len: usize = 0;
threadlocal var user_ver_buf: [16]u8 = undefined;
threadlocal var user_ver_len: usize = 0;

~proc stash-user|zig {
    user_id_v = uid;
    user_role_v = role;
    const n = @min(name.len, user_name_buf.len);
    @memcpy(user_name_buf[0..n], name[0..n]);
    user_name_len = n;
    const v = @min(ver.len, user_ver_buf.len);
    @memcpy(user_ver_buf[0..v], ver[0..v]);
    user_ver_len = v;
}

~proc user-id|zig {
    return user_id_v;
}

~proc user-name|zig {
    return user_name_buf[0..user_name_len];
}

~proc user-ver|zig {
    return user_ver_buf[0..user_ver_len];
}

// `User#title`: [ name, bio ].compact_blank.join(" – ").
threadlocal var title_buf: [512]u8 = undefined;

~proc user-title|zig {
    if (bio.len == 0) return name;
    return std.fmt.bufPrint(&title_buf, "{s} – {s}", .{ name, bio }) catch name;
}

// `body_classes`: [ body_class, admin_body_class, logo_class ].compact.join.
// The show page's own body_class is "sidebar"; "admin" when the user can
// administer; no account logo in the seed, so no logo class.
~proc body-class|zig {
    return if (user_role_v == 1) "sidebar admin" else "sidebar";
}

// CGI.escapeHTML for non-component writes (sidebar/search row loops build
// markup by hand): & < > " ' — same five the contract's escapeHTML produces.
threadlocal var esc_buf: [512]u8 = undefined;

~proc html-esc|zig {
    var n: usize = 0;
    for (text) |c| {
        const rep: []const u8 = switch (c) {
            '&' => "&amp;", '<' => "&lt;", '>' => "&gt;",
            '"' => "&quot;", '\'' => "&#39;",
            else => "",
        };
        if (rep.len == 0) {
            if (n >= esc_buf.len) break;
            esc_buf[n] = c;
            n += 1;
        } else {
            if (n + rep.len > esc_buf.len) break;
            @memcpy(esc_buf[n .. n + rep.len], rep);
            n += rep.len;
        }
    }
    return esc_buf[0..n];
}

// The member gate the page's done arm reads: true only when the room query
// produced a row this request (stash-room ran). Reset per request by
// page-reset.
~proc room-present|zig {
    return room_seen;
}

~proc room-name|zig {
    return room_name_buf[0..room_name_len];
}

// Rooms::Closed -> rooms_closed — the param_key that dom_id prefixes carry.
fn roomKey() []const u8 {
    const t = room_type_buf[0..room_type_len];
    if (std.mem.eql(u8, t, "Rooms::Closed")) return "rooms_closed";
    if (std.mem.eql(u8, t, "Rooms::Open")) return "rooms_open";
    if (std.mem.eql(u8, t, "Rooms::Direct")) return "rooms_direct";
    return "rooms_room";
}

~proc room-key|zig {
    return roomKey();
}

// The STI class name verbatim ("Rooms::Closed") — the GID in the signed
// stream name needs it, unlike the param_key above.
~proc room-type|zig {
    return room_type_buf[0..room_type_len];
}

// ── Timestamps ──────────────────────────────────────────────────────────────
// Seed datetimes are "YYYY-MM-DD HH:MM:SS" (optionally ".ffffff").

// days-from-civil (Hinnant) — no epoch table.
fn daysFromCivil(y0: i64, m: i64, d: i64) i64 {
    const y = if (m <= 2) y0 - 1 else y0;
    const era = @divFloor(if (y >= 0) y else y - 399, 400);
    const yoe = y - era * 400;
    const mp = @mod(m + 9, 12);
    const doy = @divTrunc(153 * mp + 2, 5) + d - 1;
    const doe = yoe * 365 + @divTrunc(yoe, 4) - @divTrunc(yoe, 100) + doy;
    return era * 146097 + doe - 719468;
}

fn numAt(ts: []const u8, i: usize, n: usize) i64 {
    var v: i64 = 0;
    for (ts[i .. i + n]) |ch| v = v * 10 + (ch - '0');
    return v;
}

// "YYYY-MM-DD HH:MM:SS[.ffffff]" -> epoch milliseconds.
~proc ts-ms|zig {
    if (ts.len < 19) return 0;
    const days = daysFromCivil(numAt(ts, 0, 4), numAt(ts, 5, 2), numAt(ts, 8, 2));
    return days * 86_400_000 + numAt(ts, 11, 2) * 3_600_000 + numAt(ts, 14, 2) * 60_000 + numAt(ts, 17, 2) * 1000;
}

// "YYYY-MM-DD HH:MM:SS[.ffffff]" -> "YYYY-MM-DDTHH:MM:SSZ" (fraction dropped,
// matching the port's wire shape).
threadlocal var iso_buf: [40]u8 = undefined;

~proc ts-iso|zig {
    if (ts.len < 19) return "";
    @memcpy(iso_buf[0..10], ts[0..10]);
    iso_buf[10] = 'T';
    @memcpy(iso_buf[11..19], ts[11..19]);
    iso_buf[19] = 'Z';
    return iso_buf[0..20];
}

// "YYYY-MM-DD HH:MM:SS" -> "YYYYMMDDHHMMSS" — the ?v= cache-buster shape Rails
// stamps on avatar/logo URLs from a record's updated_at.
threadlocal var ver_buf: [16]u8 = undefined;

~proc ts-ver|zig {
    if (ts.len < 19) return "";
    @memcpy(ver_buf[0..4], ts[0..4]);
    @memcpy(ver_buf[4..6], ts[5..7]);
    @memcpy(ver_buf[6..8], ts[8..10]);
    @memcpy(ver_buf[8..10], ts[11..13]);
    @memcpy(ver_buf[10..12], ts[14..16]);
    @memcpy(ver_buf[12..14], ts[17..19]);
    return ver_buf[0..14];
}

// Render-time milliseconds — the messages container's loaded-at value.
~proc now-ms|zig {
    return std.time.milliTimestamp();
}

// `message-render` — the pub face of the Msg component for the broadcast
// path. The component's render event emits as a sibling symbol in this
// module, so the proc forwards its Input verbatim; the returned buffer
// carries its `allocated!` obligation to the caller.
~proc message-render|zig {
    return Msg_render_event.handler(.{ .cmid = cmid, .mid = mid, .uid = uid,
        .rid = rid, .ms = ms, .ums = ums, .iso = iso, .author = author,
        .atitle = atitle, .uver = uver, .usgid = usgid, .roomname = roomname,
        .body = body, .boosts = boosts, .host = originFor(host),
        .csrf = csrfTok() });
}

~proc edit-render|zig {
    return EditMsg_render_event.handler(.{ .cmid = cmid, .rid = rid,
        .mid = mid, .body = body, .host = originFor(host),
        .csrf = csrfTok() });
}

// "rooms_<key>_<rid>" — the room dom_id body, shared by messages_, edit_,
// involvement_ prefixes.
threadlocal var msgdom_buf: [320]u8 = undefined;

~proc msgdom|zig {
    return std.fmt.bufPrint(&msgdom_buf, "{s}_{s}", .{ roomKey(), rid }) catch "";
}

// dom_id(message) — the refresh stream's replace target ("message_<cmid>").
threadlocal var mdom_buf: [96]u8 = undefined;

~proc mdom|zig {
    return std.fmt.bufPrint(&mdom_buf, "message_{s}", .{cmid}) catch "";
}

// /rooms/<plural>/<rid>/edit — the room edit path is type-pluralized.
threadlocal var room_edit_buf: [320]u8 = undefined;

~proc room-edit-path|zig {
    const plural = blk: {
        const t = room_type_buf[0..room_type_len];
        if (std.mem.eql(u8, t, "Rooms::Closed")) break :blk "closeds";
        if (std.mem.eql(u8, t, "Rooms::Open")) break :blk "opens";
        if (std.mem.eql(u8, t, "Rooms::Direct")) break :blk "directs";
        break :blk "rooms";
    };
    return std.fmt.bufPrint(&room_edit_buf, "/rooms/{s}/{s}/edit", .{ plural, rid }) catch "";
}

// Host header unwrap — HTTP/1.1 requires Host; absent means a malformed
// request, and an empty value then renders as a visibly broken URL rather
// than silently wrong content. Returns the full origin: `https://h`
// (Rails' assume_ssl posture) or `http://h` under DISABLE_SSL, so every
// absolute URL the page emits carries the scheme the client actually used.
threadlocal var origin_buf: [320]u8 = undefined;

fn originFor(h: ?[]const u8) []const u8 {
    const host = h orelse return "";
    const proto: []const u8 = if (std.posix.getenv("DISABLE_SSL") != null) "http" else "https";
    return std.fmt.bufPrint(&origin_buf, "{s}://{s}", .{ proto, host }) catch "";
}

~proc host-or|zig {
    return originFor(h);
}

// ── Boost arena ─────────────────────────────────────────────────────────────
// Boosts are queried in one shot for the page window (a join against the
// last-40 subquery), rendered to markup, and stashed per message_id; the
// message row arm reads them out via boost-rows. The arena resets per
// request in page-reset — markup bytes live exactly as long as the page.
threadlocal var boost_arena: std.ArrayList(u8) = .empty;
threadlocal var boost_mid: [64]i64 = undefined;
threadlocal var boost_off: [64]u32 = undefined;
threadlocal var boost_len: [64]u32 = undefined;
threadlocal var boost_n: usize = 0;

~proc boost-stash|zig {
    if (boost_n >= 64) return;
    boost_mid[boost_n] = mid;
    boost_off[boost_n] = @intCast(boost_arena.items.len);
    boost_len[boost_n] = @intCast(html.len);
    boost_arena.appendSlice(std.heap.page_allocator, html) catch return;
    boost_n += 1;
}

threadlocal var boost_ret: std.ArrayList(u8) = .empty;

~proc boost-rows|zig {
    boost_ret.clearRetainingCapacity();
    for (0..boost_n) |i| {
        if (boost_mid[i] == mid)
            boost_ret.appendSlice(std.heap.page_allocator,
                boost_arena.items[boost_off[i]..boost_off[i] + boost_len[i]]) catch return "";
    }
    return boost_ret.items;
}

~proc page-reset|zig {
    room_seen = false;
    boost_n = 0;
    boost_arena.clearRetainingCapacity();
}

// ── Application-page helpers ────────────────────────────────────────────────
// Small render helpers the page flows share. All threadlocal, same
// request-scoped argument as the stashes above.

fn escInto(out: []u8, n: *usize, s: []const u8) void {
    for (s) |c| {
        const rep: []const u8 = switch (c) {
            '&' => "&amp;", '<' => "&lt;", '>' => "&gt;",
            '"' => "&quot;", '\'' => "&#39;",
            else => "",
        };
        if (rep.len == 0) {
            if (n.* >= out.len) return;
            out[n.*] = c;
            n.* += 1;
        } else {
            if (n.* + rep.len > out.len) return;
            @memcpy(out[n.* .. n.* + rep.len], rep);
            n.* += rep.len;
        }
    }
}

fn appendInto(out: []u8, n: *usize, s: []const u8) void {
    if (n.* + s.len > out.len) return;
    @memcpy(out[n.* .. n.* + s.len], s);
    n.* += s.len;
}

// The h1 interior: directs get the "Ping with" screen-reader prefix, every
// other room its escaped name.
threadlocal var navtitle_buf: [512]u8 = undefined;

~proc nav-title|zig {
    var n: usize = 0;
    if (std.mem.eql(u8, rtype, "Rooms::Direct"))
        appendInto(&navtitle_buf, &n, "<span class=\"for-screen-reader\">Ping with</span>");
    escInto(&navtitle_buf, &n, name);
    return navtitle_buf[0..n];
}

~proc settings-label|zig {
    return if (std.mem.eql(u8, rtype, "Rooms::Direct")) "Settings for this Ping" else "Settings for this room";
}

// current_user_meta_tags — present on every authenticated page, absent on
// the public transfer/join pages (uid <= 0).
threadlocal var metas_buf: [512]u8 = undefined;

~proc user-metas|zig {
    if (uid <= 0) return "";
    var n: usize = 0;
    const pre = "<meta name=\"current-user-id\" content=\"";
    appendInto(&metas_buf, &n, pre);
    const num = std.fmt.bufPrint(metas_buf[n..], "{d}", .{uid}) catch return "";
    n += num.len;
    appendInto(&metas_buf, &n, "\" /><meta name=\"current-user-name\" content=\"");
    escInto(&metas_buf, &n, name);
    appendInto(&metas_buf, &n, "\" />");
    return metas_buf[0..n];
}

// ── CSRF surface ──────────────────────────────────────────────────────────
// The request's masked authenticity token, stashed by the route after the
// session cookie verifies (signing:csrf-token produces the mask). One mask
// per page — Rails re-pads per form; the pad is per-emission obfuscation of
// the same session-bound secret, so a shared page mask verifies identically
// and is honest about the weaker replay shape. Empty stash → empty tokens,
// which can never verify (csrf-verify rejects empty/absent presentations).
threadlocal var csrf_buf: [96]u8 = undefined;
threadlocal var csrf_len: usize = 0;

~proc csrf-stash|zig {
    if (masked) |m| {
        const n = @min(m.len, csrf_buf.len);
        @memcpy(csrf_buf[0..n], m[0..n]);
        csrf_len = n;
    } else csrf_len = 0;
}

fn csrfTok() []const u8 {
    return csrf_buf[0..csrf_len];
}

~proc csrf-get|zig {
    return csrfTok();
}

// csrf_meta_tags — inside <head> through the metas slot, after the page's
// own metas (`pre`: the current-user pair, the room meta).
threadlocal var csrf_meta_buf: [2048]u8 = undefined;

~proc csrf-metas|zig {
    var n: usize = 0;
    appendInto(&csrf_meta_buf, &n, pre);
    if (csrf_len > 0) {
        appendInto(&csrf_meta_buf, &n,
            "<meta name=\"csrf-param\" content=\"authenticity_token\" /><meta name=\"csrf-token\" content=\"");
        appendInto(&csrf_meta_buf, &n, csrfTok());
        appendInto(&csrf_meta_buf, &n, "\" />");
    }
    return csrf_meta_buf[0..n];
}

threadlocal var metacat_buf: [4096]u8 = undefined;

~proc meta-cat|zig {
    var n: usize = 0;
    appendInto(&metacat_buf, &n, a);
    appendInto(&metacat_buf, &n, b);
    return metacat_buf[0..n];
}

// tag.meta(name: "current-room-id") — the reference layout emits it inside
// <head> on room pages; component markup can't splice there, so it joins
// the metas string. Own buffer: `pre` may be metacat_buf's own contents.
threadlocal var roommeta_buf: [4096]u8 = undefined;

~proc room-meta|zig {
    var n: usize = 0;
    appendInto(&roommeta_buf, &n, pre);
    appendInto(&roommeta_buf, &n, "<meta name=\"current-room-id\" content=\"");
    escInto(&roommeta_buf, &n, rid);
    appendInto(&roommeta_buf, &n, "\">");
    return roommeta_buf[0..n];
}

// The form helper's hidden input — first child of every non-GET form.
// Components take the token as a `csrf` field; proc-built forms splice
// csrfInputZ directly.
fn csrfInputZ(buf: []u8) []const u8 {
    if (csrf_len == 0) return "";
    return std.fmt.bufPrint(buf,
        "<input type=\"hidden\" name=\"authenticity_token\" value=\"{s}\" />",
        .{csrfTok()}) catch "";
}

threadlocal var csrf_in_buf: [192]u8 = undefined;

~proc csrf-input|zig {
    return csrfInputZ(&csrf_in_buf);
}

// body_classes for the turbo-frame pages the reference renders inside the
// app layout (sidebar, searches): the class list is [page classes] ++
// admin flag — "admin"/"" for the sidebar, "sidebar searches[ admin]" for
// search. base is the page classes prefix.
threadlocal var acls_buf: [64]u8 = undefined;

~proc admin-cls|zig {
    if (role != 1) return base;
    if (base.len == 0) return "admin";
    return std.fmt.bufPrint(&acls_buf, "{s} admin", .{base}) catch base;
}

// public/422.html verbatim — the reference's InvalidAuthenticityToken page
// (and the failed-login surface). Read once, cached for the process: the
// body is process-owned, never per-request-allocated, so responses must
// NOT set body_allocated (the pump would free the cache).
threadlocal var unp_body: ?[]const u8 = null;

~proc unprocessable-body|zig {
    if (unp_body) |b| return b;
    const f = std.fs.cwd().openFile("public/422.html", .{}) catch return "";
    defer f.close();
    const b = f.readToEndAlloc(koru_allocator(), 1 << 20) catch return "";
    unp_body = b;
    return b;
}

// The 422 Response itself — flows can't yield a bare record literal at
// chain end, so the shape lives here like respond-created's.
~proc respond-unprocessable|zig {
    return .{ .status = 422, .body = body, .content_type = "text/html" };
}

// custom_styles_tag — `tag.style(css.html_safe, data-turbo-track: reload)`.
// Raw CSS verbatim (the reference marks it html_safe); empty/nil emits
// nothing so pages don't ship a dead <style>.
threadlocal var style_buf: [8192]u8 = undefined;

~proc style-wrap|zig {
    const c = css orelse return "";
    if (c.len == 0) return "";
    var n: usize = 0;
    appendInto(&style_buf, &n, "<style data-turbo-track=\"reload\">");
    appendInto(&style_buf, &n, c);
    appendInto(&style_buf, &n, "</style>");
    return style_buf[0..n];
}

// The css query's row arm borrows die with the row — same stash shape as
// session:stash-text, kept local so views needs no cross-module cell.
threadlocal var css_buf: [8192]u8 = undefined;
threadlocal var css_len: usize = 0;

~proc css-stash|zig {
    css_len = @min(css.len, css_buf.len);
    @memcpy(css_buf[0..css_len], css[0..css_len]);
}

~proc css-take|zig {
    if (css_len == 0) return null;
    return css_buf[0..css_len];
}

// Turbo stream envelope for the sidebar broadcasts — prepend for a new
// room, replace for a rename. Same wrapper shape as messages'
// turbo-wrap, parameterized.
threadlocal var sw_buf: [65536]u8 = undefined;

~proc stream-wrap|zig {
    var n: usize = 0;
    appendInto(&sw_buf, &n, "<turbo-stream action=\"");
    appendInto(&sw_buf, &n, action);
    appendInto(&sw_buf, &n, "\" target=\"");
    appendInto(&sw_buf, &n, target);
    appendInto(&sw_buf, &n, "\"><template>");
    appendInto(&sw_buf, &n, html);
    appendInto(&sw_buf, &n, "</template></turbo-stream>");
    return sw_buf[0..n];
}

// The shared-room sidebar anchor — users/sidebars/rooms/_shared verbatim
// minus unread class + fresh flag (a broadcast row arrives without an
// unread computation; the rooms-list controller's unread class lands on
// the next ping if it applies).
threadlocal var rlink_buf: [2048]u8 = undefined;

~proc room-link|zig {
    var n: usize = 0;
    appendInto(&rlink_buf, &n, "<a id=\"list_");
    appendInto(&rlink_buf, &n, rk);
    appendInto(&rlink_buf, &n, "_");
    appendInto(&rlink_buf, &n, rid);
    appendInto(&rlink_buf, &n, "\" data-rooms-list-target=\"room\" data-room-id=\"");
    appendInto(&rlink_buf, &n, rid);
    appendInto(&rlink_buf, &n, "\" data-badge-dot-target=\"unread\" data-sorted-list-target=\"item\" data-sorted-list-name=\"");
    escInto(&rlink_buf, &n, name);
    appendInto(&rlink_buf, &n, "\" class=\"align-center gap room btn txt-nowrap\" href=\"/rooms/");
    appendInto(&rlink_buf, &n, rid);
    appendInto(&rlink_buf, &n, "\"><span class=\"overflow-ellipsis\">");
    escInto(&rlink_buf, &n, name);
    appendInto(&rlink_buf, &n, "</span></a>");
    return rlink_buf[0..n];
}

// The direct-room sidebar anchor — _direct partial: avatar, "Ping with"
// sr prefix, other member's name. Broadcast target #direct_rooms on the
// member's user_<id>_rooms stream.
threadlocal var dlink_buf: [2048]u8 = undefined;

~proc direct-link|zig {
    var n: usize = 0;
    appendInto(&dlink_buf, &n, "<a class=\"direct\" id=\"list_rooms_direct_");
    appendInto(&dlink_buf, &n, rid);
    appendInto(&dlink_buf, &n, "\" data-rooms-list-target=\"room\" data-room-id=\"");
    appendInto(&dlink_buf, &n, rid);
    appendInto(&dlink_buf, &n, "\" data-badge-dot-target=\"unread\" data-sorted-list-target=\"item\" href=\"/rooms/");
    appendInto(&dlink_buf, &n, rid);
    appendInto(&dlink_buf, &n, "\"><span class=\"avatar\"><img aria-hidden=\"true\" src=\"/users/");
    appendInto(&dlink_buf, &n, sgid);
    appendInto(&dlink_buf, &n, "/avatar?v=");
    appendInto(&dlink_buf, &n, ver);
    appendInto(&dlink_buf, &n, "\" width=\"48\" height=\"48\" /></span><span class=\"direct__author flex align-center gap max-width min-width border-radius txt-small\"><span class=\"txt-nowrap overflow-ellipsis\"><span class=\"for-screen-reader\">Ping with</span>");
    escInto(&dlink_buf, &n, name);
    appendInto(&dlink_buf, &n, "</span></span></a>");
    return dlink_buf[0..n];
}

// Profile memberships menu row — _membership partial trimmed to the link
// itself (the partial's role crown and avatar ride the same anchors).
threadlocal var mlink_buf: [1024]u8 = undefined;

~proc memb-link|zig {
    var n: usize = 0;
    appendInto(&mlink_buf, &n, "<li class=\"flex align-center gap margin-none\"><a class=\"btn flex-item-grow txt-align-start overflow-ellipsis\" href=\"/rooms/");
    appendInto(&mlink_buf, &n, rid);
    appendInto(&mlink_buf, &n, "\">");
    escInto(&mlink_buf, &n, name);
    appendInto(&mlink_buf, &n, "</a></li>");
    return mlink_buf[0..n];
}

// "id-token" — User::Bot#bot_key, the credential embedded in bot message
// URLs.
threadlocal var bkey_buf: [128]u8 = undefined;

~proc bot-key|zig {
    return std.fmt.bufPrint(&bkey_buf, "{d}-{s}", .{ id, token }) catch "";
}

// `curl -d 'Hello!' <origin>/rooms/<rid>/<bot_key>/messages` — the index's
// copy-paste command line.
threadlocal var curl_buf: [1024]u8 = undefined;

~proc curl-line|zig {
    return std.fmt.bufPrint(&curl_buf, "curl -d 'Hello!' {s}/rooms/{s}/{s}/messages", .{ host, rid, key }) catch "";
}

// Bot rows accumulate across the flat bots×rooms join: a new uid opens a
// new <li>, each room appends its access fieldset. bots-take closes the
// open <li> and answers the whole <menu> interior.
threadlocal var brows: std.ArrayList(u8) = .empty;
threadlocal var brows_last: i64 = -1;

~proc bots-begin|zig {
    brows.clearRetainingCapacity();
    brows_last = -1;
}

fn browsAppend(s: []const u8) void {
    brows.appendSlice(std.heap.page_allocator, s) catch {};
}

threadlocal var btmp: [1024]u8 = undefined;

~proc bot-row|zig {
    if (uid != brows_last) {
        if (brows_last >= 0) browsAppend("</li>");
        brows_last = uid;
        browsAppend("<li class=\"flex flex-column gap flush fill-shade border-radius pad-block pad-inline-double\"><div class=\"flex align-center gap\"><div class=\"min-width\"><div class=\"overflow-ellipsis txt-large\"><strong>");
        const e = escHtmlSlice(name);
        browsAppend(e);
        browsAppend("</strong></div></div>");
        const ep = std.fmt.bufPrint(&btmp, "<a class=\"btn flex-item-justify-end\" href=\"/account/bots/{d}/edit\"><img aria-hidden=\"true\" src=\"/assets/pencil-cf9d28aa.svg\" width=\"20\" height=\"20\" /><span class=\"for-screen-reader\">Edit ", .{uid}) catch "";
        browsAppend(ep);
        browsAppend(e);
        browsAppend("</span></a></div>");
    }
    if (rid > 0) {
        const line = std.fmt.bufPrint(&btmp, "curl -d 'Hello!' {s}/rooms/{d}/{s}/messages", .{ host, rid, key }) catch "";
        browsAppend("<fieldset class=\"gap max-width pad border border-radius\"><legend class=\"min-width txt-align-start pad-inline\"><strong class=\"overflow-ellipsis\">");
        browsAppend(escHtmlSlice(rname));
        browsAppend("</strong></legend><div class=\"flex align-center gap\"><div class=\"flex-item-grow\"><input type=\"text\" class=\"input full-width fill-white\" value=\"");
        browsAppend(escHtmlSlice(line));
        browsAppend("\" aria-label=\"curl command for posting messages\" readonly></div></div></fieldset>");
    }
    return "";
}

threadlocal var esc2_buf: [512]u8 = undefined;

fn escHtmlSlice(s: []const u8) []const u8 {
    var n: usize = 0;
    escInto(&esc2_buf, &n, s);
    return esc2_buf[0..n];
}

~proc bots-take|zig {
    if (brows_last >= 0) browsAppend("</li>");
    return brows.items;
}

// accounts/_users row — avatar, name, and the admin crown only.
threadlocal var auser_buf: [2048]u8 = undefined;

~proc acct-user|zig {
    var n: usize = 0;
    appendInto(&auser_buf, &n, "<li class=\"flex align-center gap margin-none\"><a title=\"");
    escInto(&auser_buf, &n, uname);
    appendInto(&auser_buf, &n, "\" class=\"btn avatar\" href=\"/users/");
    const unum = std.fmt.bufPrint(auser_buf[n..], "{d}", .{uid}) catch "";
    n += unum.len;
    appendInto(&auser_buf, &n, "\"><img aria-hidden=\"true\" src=\"/users/");
    appendInto(&auser_buf, &n, sgid);
    appendInto(&auser_buf, &n, "/avatar?v=");
    appendInto(&auser_buf, &n, ver);
    appendInto(&auser_buf, &n, "\" width=\"48\" height=\"48\" /></a><div class=\"min-width\"><div class=\"overflow-ellipsis\"><strong>");
    escInto(&auser_buf, &n, uname);
    appendInto(&auser_buf, &n, "</strong>");
    if (role == 1) appendInto(&auser_buf, &n, " <img aria-hidden=\"true\" class=\"colorize--black\" src=\"/assets/crown-00d190cb.svg\" width=\"14\" height=\"14\" />");
    appendInto(&auser_buf, &n, "</div></div></li>");
    return auser_buf[0..n];
}

// The room form's member-preview row — who has access, display only.
threadlocal var ruser_buf: [2048]u8 = undefined;

~proc room-user|zig {
    var n: usize = 0;
    appendInto(&ruser_buf, &n, "<li class=\"flex align-center gap margin-none\" data-value=\"");
    escInto(&ruser_buf, &n, uname);
    appendInto(&ruser_buf, &n, "\"><figure class=\"avatar flex-item-no-shrink\" style=\"--avatar-size: 4ch;\"><img aria-hidden=\"true\" src=\"/users/");
    appendInto(&ruser_buf, &n, sgid);
    appendInto(&ruser_buf, &n, "/avatar?v=");
    appendInto(&ruser_buf, &n, ver);
    appendInto(&ruser_buf, &n, "\" width=\"48\" height=\"48\" /></figure><div class=\"min-width\"><div class=\"overflow-ellipsis\"><strong>");
    escInto(&ruser_buf, &n, uname);
    appendInto(&ruser_buf, &n, "</strong></div></div></li>");
    return ruser_buf[0..n];
}

// ── Autocomplete JSON ───────────────────────────────────────────────────────
// /autocompletable/users answers the suggestion controller's JSON shape:
// [{name, value, avatar_url, sgid}]. Accumulated across rows; jsonEsc is
// the JSON-string codec (\" \\ control, and \uXXXX below 0x20).
threadlocal var ac_buf: std.ArrayList(u8) = .empty;
threadlocal var ac_n: usize = 0;
threadlocal var ac_tmp: [512]u8 = undefined;

fn jsonEsc(out: []u8, n: *usize, s: []const u8) void {
    for (s) |c| {
        switch (c) {
            '"' => appendInto(out, n, "\\\""),
            '\\' => appendInto(out, n, "\\\\"),
            else => {
                if (c < 0x20) {
                    const esc = std.fmt.bufPrint(out[n.*..], "\\u{x:0>4}", .{c}) catch return;
                    n.* += esc.len;
                } else {
                    if (n.* >= out.len) return;
                    out[n.*] = c;
                    n.* += 1;
                }
            },
        }
    }
}

~proc ac-begin|zig {
    ac_buf.clearRetainingCapacity();
    ac_buf.appendSlice(std.heap.page_allocator, "[") catch {};
    ac_n = 0;
}

~proc ac-row|zig {
    if (ac_n > 0) ac_buf.appendSlice(std.heap.page_allocator, ",") catch {};
    ac_n += 1;
    var n: usize = 0;
    appendInto(&ac_tmp, &n, "{\"name\":\"");
    jsonEsc(&ac_tmp, &n, name);
    appendInto(&ac_tmp, &n, "\",\"value\":");
    const unum = std.fmt.bufPrint(ac_tmp[n..], "{d}", .{uid}) catch return "";
    n += unum.len;
    appendInto(&ac_tmp, &n, ",\"avatar_url\":\"/users/");
    appendInto(&ac_tmp, &n, sgid);
    appendInto(&ac_tmp, &n, "/avatar?v=");
    appendInto(&ac_tmp, &n, ver);
    appendInto(&ac_tmp, &n, "\",\"sgid\":\"");
    appendInto(&ac_tmp, &n, sgid);
    appendInto(&ac_tmp, &n, "\"}");
    ac_buf.appendSlice(std.heap.page_allocator, ac_tmp[0..n]) catch {};
    return "";
}

~proc ac-take|zig {
    ac_buf.appendSlice(std.heap.page_allocator, "]") catch {};
    return ac_buf.items;
}

// ── Auth + account stashes ──────────────────────────────────────────────────
// auth-stash fills the same user cells stash-user does (so user-id/-name/
// -ver/body-class keep working on app pages) plus email/bio, which the
// profile form needs. acct-stash carries the singleton account's name and
// join_code across the done boundary.
threadlocal var auth_email_buf: [320]u8 = undefined;
threadlocal var auth_email_len: usize = 0;
threadlocal var auth_bio_buf: [512]u8 = undefined;
threadlocal var auth_bio_len: usize = 0;

~proc auth-stash|zig {
    user_id_v = uid;
    user_role_v = role;
    const n = @min(name.len, user_name_buf.len);
    @memcpy(user_name_buf[0..n], name[0..n]);
    user_name_len = n;
    const v = @min(ver.len, user_ver_buf.len);
    @memcpy(user_ver_buf[0..v], ver[0..v]);
    user_ver_len = v;
    const e = @min(email.len, auth_email_buf.len);
    @memcpy(auth_email_buf[0..e], email[0..e]);
    auth_email_len = e;
    const b = @min(bio.len, auth_bio_buf.len);
    @memcpy(auth_bio_buf[0..b], bio[0..b]);
    auth_bio_len = b;
}

~proc user-role|zig {
    return user_role_v;
}

~proc auth-email|zig {
    return auth_email_buf[0..auth_email_len];
}

~proc auth-bio|zig {
    return auth_bio_buf[0..auth_bio_len];
}

threadlocal var acct_name_buf: [256]u8 = undefined;
threadlocal var acct_name_len: usize = 0;
threadlocal var acct_join_buf: [64]u8 = undefined;
threadlocal var acct_join_len: usize = 0;
threadlocal var acct_restrict_v: i64 = 0;
threadlocal var acct_ver_buf: [16]u8 = undefined;
threadlocal var acct_ver_len: usize = 0;

~proc acct-stash|zig {
