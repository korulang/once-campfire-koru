// views/index.kz — the zig half of the views module: request-scoped stashes
// (room, current user, boost arena), timestamp shaping, path keys. Markup
// lives in index.k (components); this file is arithmetic and state only.

const std = @import("std");

// ── Room stash — the room row fires once, the shell needs its values ────────
// Same threadlocal-cell pattern as session/: a handler runs to completion on
// one worker thread, so these cells are request-scoped.
threadlocal var room_name_buf: [256]u8 = undefined;
threadlocal var room_name_len: usize = 0;
threadlocal var room_type_buf: [64]u8 = undefined;
threadlocal var room_type_len: usize = 0;
threadlocal var room_seen: bool = false;

~proc stash-room|zig {
    const n = @min(name.len, room_name_buf.len);
    @memcpy(room_name_buf[0..n], name[0..n]);
    room_name_len = n;
    const t = @min(rtype.len, room_type_buf.len);
    @memcpy(room_type_buf[0..t], rtype[0..t]);
    room_type_len = t;
    room_seen = true;
}

// ── User stash — the membership join also yields the current user ───────────
threadlocal var user_id_v: i64 = 0;
threadlocal var user_role_v: i64 = 0;
threadlocal var user_name_buf: [256]u8 = undefined;
threadlocal var user_name_len: usize = 0;
threadlocal var user_ver_buf: [16]u8 = undefined;
threadlocal var user_ver_len: usize = 0;

~proc stash-user|zig {
    user_id_v = uid;
    user_role_v = role;
    const n = @min(name.len, user_name_buf.len);
    @memcpy(user_name_buf[0..n], name[0..n]);
    user_name_len = n;
    const v = @min(ver.len, user_ver_buf.len);
    @memcpy(user_ver_buf[0..v], ver[0..v]);
    user_ver_len = v;
}

~proc user-id|zig {
    return user_id_v;
}

~proc user-name|zig {
    return user_name_buf[0..user_name_len];
}

~proc user-ver|zig {
    return user_ver_buf[0..user_ver_len];
}

// `User#title`: [ name, bio ].compact_blank.join(" – ").
threadlocal var title_buf: [512]u8 = undefined;

~proc user-title|zig {
    if (bio.len == 0) return name;
    return std.fmt.bufPrint(&title_buf, "{s} – {s}", .{ name, bio }) catch name;
}

// `body_classes`: [ body_class, admin_body_class, logo_class ].compact.join.
// The show page's own body_class is "sidebar"; "admin" when the user can
// administer; no account logo in the seed, so no logo class.
~proc body-class|zig {
    return if (user_role_v == 1) "sidebar admin" else "sidebar";
}

// The member gate the page's done arm reads: true only when the room query
// produced a row this request (stash-room ran). Reset per request by
// page-reset.
~proc room-present|zig {
    return room_seen;
}

~proc room-name|zig {
    return room_name_buf[0..room_name_len];
}

// Rooms::Closed -> rooms_closed — the param_key that dom_id prefixes carry.
fn roomKey() []const u8 {
    const t = room_type_buf[0..room_type_len];
    if (std.mem.eql(u8, t, "Rooms::Closed")) return "rooms_closed";
    if (std.mem.eql(u8, t, "Rooms::Open")) return "rooms_open";
    if (std.mem.eql(u8, t, "Rooms::Direct")) return "rooms_direct";
    return "rooms_room";
}

~proc room-key|zig {
    return roomKey();
}

// The STI class name verbatim ("Rooms::Closed") — the GID in the signed
// stream name needs it, unlike the param_key above.
~proc room-type|zig {
    return room_type_buf[0..room_type_len];
}

// ── Timestamps ──────────────────────────────────────────────────────────────
// Seed datetimes are "YYYY-MM-DD HH:MM:SS" (optionally ".ffffff").

// days-from-civil (Hinnant) — no epoch table.
fn daysFromCivil(y0: i64, m: i64, d: i64) i64 {
    const y = if (m <= 2) y0 - 1 else y0;
    const era = @divFloor(if (y >= 0) y else y - 399, 400);
    const yoe = y - era * 400;
    const mp = @mod(m + 9, 12);
    const doy = @divTrunc(153 * mp + 2, 5) + d - 1;
    const doe = yoe * 365 + @divTrunc(yoe, 4) - @divTrunc(yoe, 100) + doy;
    return era * 146097 + doe - 719468;
}

fn numAt(ts: []const u8, i: usize, n: usize) i64 {
    var v: i64 = 0;
    for (ts[i .. i + n]) |ch| v = v * 10 + (ch - '0');
    return v;
}

// "YYYY-MM-DD HH:MM:SS[.ffffff]" -> epoch milliseconds.
~proc ts-ms|zig {
    if (ts.len < 19) return 0;
    const days = daysFromCivil(numAt(ts, 0, 4), numAt(ts, 5, 2), numAt(ts, 8, 2));
    return days * 86_400_000 + numAt(ts, 11, 2) * 3_600_000 + numAt(ts, 14, 2) * 60_000 + numAt(ts, 17, 2) * 1000;
}

// "YYYY-MM-DD HH:MM:SS[.ffffff]" -> "YYYY-MM-DDTHH:MM:SSZ" (fraction dropped,
// matching the port's wire shape).
threadlocal var iso_buf: [40]u8 = undefined;

~proc ts-iso|zig {
    if (ts.len < 19) return "";
    @memcpy(iso_buf[0..10], ts[0..10]);
    iso_buf[10] = 'T';
    @memcpy(iso_buf[11..19], ts[11..19]);
    iso_buf[19] = 'Z';
    return iso_buf[0..20];
}

// "YYYY-MM-DD HH:MM:SS" -> "YYYYMMDDHHMMSS" — the ?v= cache-buster shape Rails
// stamps on avatar/logo URLs from a record's updated_at.
threadlocal var ver_buf: [16]u8 = undefined;

~proc ts-ver|zig {
    if (ts.len < 19) return "";
    @memcpy(ver_buf[0..4], ts[0..4]);
    @memcpy(ver_buf[4..6], ts[5..7]);
    @memcpy(ver_buf[6..8], ts[8..10]);
    @memcpy(ver_buf[8..10], ts[11..13]);
    @memcpy(ver_buf[10..12], ts[14..16]);
    @memcpy(ver_buf[12..14], ts[17..19]);
    return ver_buf[0..14];
}

// Render-time milliseconds — the messages container's loaded-at value.
~proc now-ms|zig {
    return std.time.milliTimestamp();
}

// "rooms_<key>_<rid>" — the room dom_id body, shared by messages_, edit_,
// involvement_ prefixes.
threadlocal var msgdom_buf: [320]u8 = undefined;

~proc msgdom|zig {
    return std.fmt.bufPrint(&msgdom_buf, "{s}_{s}", .{ roomKey(), rid }) catch "";
}

// /rooms/<plural>/<rid>/edit — the room edit path is type-pluralized.
threadlocal var room_edit_buf: [320]u8 = undefined;

~proc room-edit-path|zig {
    const plural = blk: {
        const t = room_type_buf[0..room_type_len];
        if (std.mem.eql(u8, t, "Rooms::Closed")) break :blk "closeds";
        if (std.mem.eql(u8, t, "Rooms::Open")) break :blk "opens";
        if (std.mem.eql(u8, t, "Rooms::Direct")) break :blk "directs";
        break :blk "rooms";
    };
    return std.fmt.bufPrint(&room_edit_buf, "/rooms/{s}/{s}/edit", .{ plural, rid }) catch "";
}

// Host header unwrap — HTTP/1.1 requires Host; absent means a malformed
// request, and an empty value then renders as a visibly broken URL rather
// than silently wrong content.
~proc host-or|zig {
    return h orelse "";
}

// ── Boost arena ─────────────────────────────────────────────────────────────
// Boosts are queried in one shot for the page window (a join against the
// last-40 subquery), rendered to markup, and stashed per message_id; the
// message row arm reads them out via boost-rows. The arena resets per
// request in page-reset — markup bytes live exactly as long as the page.
threadlocal var boost_arena: std.ArrayList(u8) = .empty;
threadlocal var boost_mid: [64]i64 = undefined;
threadlocal var boost_off: [64]u32 = undefined;
threadlocal var boost_len: [64]u32 = undefined;
threadlocal var boost_n: usize = 0;

~proc boost-stash|zig {
    if (boost_n >= 64) return;
    boost_mid[boost_n] = mid;
    boost_off[boost_n] = @intCast(boost_arena.items.len);
    boost_len[boost_n] = @intCast(html.len);
    boost_arena.appendSlice(std.heap.page_allocator, html) catch return;
    boost_n += 1;
}

threadlocal var boost_ret: std.ArrayList(u8) = .empty;

~proc boost-rows|zig {
    boost_ret.clearRetainingCapacity();
    for (0..boost_n) |i| {
        if (boost_mid[i] == mid)
            boost_ret.appendSlice(std.heap.page_allocator,
                boost_arena.items[boost_off[i]..boost_off[i] + boost_len[i]]) catch return "";
    }
    return boost_ret.items;
}

~proc page-reset|zig {
    room_seen = false;
    boost_n = 0;
    boost_arena.clearRetainingCapacity();
}
