// edit-stash carries one or two row fields (name + optional webhook) across
// the done boundary so a form can pre-fill. Distinct buffers from every
// other stash — a profile page can hold an account name and a bot edit at
// the same time.
threadlocal var edit_name_buf: [256]u8 = undefined;
threadlocal var edit_name_len: usize = 0;
threadlocal var edit_wh_buf: [512]u8 = undefined;
threadlocal var edit_wh_len: usize = 0;

~proc edit-stash|zig {
    const n = @min(name.len, edit_name_buf.len);
    @memcpy(edit_name_buf[0..n], name[0..n]);
    edit_name_len = n;
